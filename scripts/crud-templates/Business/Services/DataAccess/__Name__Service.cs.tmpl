using AutoMapper;
using Microsoft.EntityFrameworkCore;
using Microsoft.Extensions.Logging;
using MyProject.AccessDatas;
using MyProject.AccessDatas.Models;
using MyProject.Business.Factories;
using MyProject.Business.Helpers;
using MyProject.Business.Services.Other;
using MyProject.Models.AdapterModel;
using MyProject.Models.Systems;

namespace MyProject.Business.Services.DataAccess;

/// <summary>
/// __Display__的資料服務（由 scripts/New-CrudModule.ps1 產生）：WASM 頁面經 __Name__Controller 呼叫，Web API 與畫面共用同一套規則與稽核。
/// 失敗結果帶種類（NotFound／Conflict／Invalid／Error），Controller 依它回 404／409／400／500。
/// ⚠️ 注入 IDbContextFactory、每個方法用完即棄（DataAccessServiceLifetimeTests 守門）。
/// 刪除＝軟刪除，可在「顯示已刪除」還原或永久刪除；修改以 ConcurrencyStamp 比對（別人先改過就不覆蓋）。
#IF TEAMS
/// 團隊範圍：沒有團隊（公開）或與授權團隊有交集才看得到（<see cref="RecordTeamScope"/>）。
#ENDIF
/// </summary>
public class __Name__Service
{
    private readonly IDbContextFactory<BackendDBContext> contextFactory;
#IF TEAMS
    private readonly IRecordAccessScopeProvider accessScope;
#ENDIF
    private readonly IAuditLogService auditLogService;
    private readonly CurrentUserService currentUserService;

    public IMapper Mapper { get; }
    public ILogger<__Name__Service> Logger { get; }

    public __Name__Service(
        IDbContextFactory<BackendDBContext> contextFactory,
        IMapper mapper,
        ILogger<__Name__Service> logger,
#IF TEAMS
        IRecordAccessScopeProvider accessScope,
#ENDIF
        IAuditLogService auditLogService,
        CurrentUserService currentUserService)
    {
        this.contextFactory = contextFactory;
        Mapper = mapper;
        Logger = logger;
#IF TEAMS
        this.accessScope = accessScope;
#ENDIF
        this.auditLogService = auditLogService;
        this.currentUserService = currentUserService;
    }

    /// <summary>寫一筆稽核。操作者取自 <see cref="CurrentUserService"/>（Web API 由 ApiActorMiddleware 依存取 Token 填入）；Controller 不再另寫稽核。</summary>
    private Task WriteAuditAsync(string action, int targetId, string detail, string? content = null)
    {
        var user = currentUserService.CurrentUser;
        return auditLogService.WriteAsync(
            action,
            success: true,
            actorUserId: user.Id > 0 ? user.Id : null,
            actorAccount: user.Id > 0 ? user.Account : null,
            targetType: "__Name__",
            targetId: targetId.ToString(System.Globalization.CultureInfo.InvariantCulture),
            detail: detail,
            content: content);
    }
#IF TEAMS

    private async Task<IQueryable<__Name__>> ApplyScopeAsync(IQueryable<__Name__> source)
        => RecordTeamScope.Apply(source, x => x.Teams, await accessScope.GetAsync());

    private async Task<bool> IsVisibleAsync(__Name__ item)
        => RecordTeamScope.CanAccess(item.Teams, await accessScope.GetAsync());
#ENDIF

    private static IQueryable<__Name__> ApplySearch(IQueryable<__Name__> source, string? search)
        => string.IsNullOrWhiteSpace(search)
            ? source
            : source.Where(x => x.Name.Contains(search) || (x.Description != null && x.Description.Contains(search)));

    /// <param name="isEnabled">只看啟用（true）或停用（false）的；null 不篩選（Web API 的 IsEnabled 條件）。</param>
    public async Task<DataRequestResult<__Name__AdapterModel>> GetAsync(DataRequest dataRequest, bool? isEnabled = null)
    {
        await using var context = await contextFactory.CreateDbContextAsync();
        IQueryable<__Name__> dataSource = ApplySearch(context.__Name__.AsNoTracking(), dataRequest.Search);
        if (isEnabled is { } enabledOnly)
        {
            dataSource = dataSource.Where(x => x.IsEnabled == enabledOnly);
        }
#IF TEAMS
        dataSource = await ApplyScopeAsync(dataSource);
#ENDIF

        IOrderedQueryable<__Name__>? sorted = null;
        if (dataRequest.SortDescending is { } descending)
        {
            sorted = dataRequest.SortField switch
            {
                nameof(__Name__AdapterModel.Name) => descending ? dataSource.OrderByDescending(x => x.Name).ThenByDescending(x => x.Id) : dataSource.OrderBy(x => x.Name).ThenBy(x => x.Id),
                nameof(__Name__AdapterModel.IsEnabled) => descending ? dataSource.OrderByDescending(x => x.IsEnabled).ThenByDescending(x => x.Id) : dataSource.OrderBy(x => x.IsEnabled).ThenBy(x => x.Id),
                nameof(__Name__AdapterModel.CreatedAt) => descending ? dataSource.OrderByDescending(x => x.CreatedAt).ThenByDescending(x => x.Id) : dataSource.OrderBy(x => x.CreatedAt).ThenBy(x => x.Id),
                nameof(__Name__AdapterModel.UpdatedAt) => descending ? dataSource.OrderByDescending(x => x.UpdatedAt).ThenByDescending(x => x.Id) : dataSource.OrderBy(x => x.UpdatedAt).ThenBy(x => x.Id),
                _ => null,
            };
        }

        // Skip/Take 一定要搭配 OrderBy：未指定、不認得的欄位或方向為 null 時退回預設排序。
        dataSource = sorted ?? dataSource.OrderByDescending(x => x.UpdatedAt).ThenByDescending(x => x.Id);

        var result = new DataRequestResult<__Name__AdapterModel> { Count = await dataSource.CountAsync() };
        dataSource = dataSource.Skip((dataRequest.CurrentPage - 1) * dataRequest.PageSize);
        if (dataRequest.Take != 0)
        {
            dataSource = dataSource.Take(dataRequest.PageSize);
        }

        result.Result = Mapper.Map<List<__Name__AdapterModel>>(await dataSource.ToListAsync());
        Logger.LogDebug("Loaded __name__ records. Count={Count}", result.Count);
        return result;
    }

    /// <summary>已刪除的資料（「顯示已刪除」清單），固定依刪除時間由新到舊。</summary>
    public async Task<DataRequestResult<__Name__AdapterModel>> GetDeletedAsync(DataRequest dataRequest)
    {
        await using var context = await contextFactory.CreateDbContextAsync();
        IQueryable<__Name__> dataSource = ApplySearch(
            context.__Name__.IgnoreQueryFilters([ISoftDeletable.FilterName]).AsNoTracking().Where(x => x.IsDeleted),
            dataRequest.Search);
#IF TEAMS
        dataSource = await ApplyScopeAsync(dataSource);
#ENDIF
        dataSource = dataSource.OrderByDescending(x => x.DeletedAt).ThenByDescending(x => x.Id);

        var result = new DataRequestResult<__Name__AdapterModel> { Count = await dataSource.CountAsync() };
        dataSource = dataSource.Skip((dataRequest.CurrentPage - 1) * dataRequest.PageSize);
        if (dataRequest.Take != 0)
        {
            dataSource = dataSource.Take(dataRequest.PageSize);
        }

        result.Result = Mapper.Map<List<__Name__AdapterModel>>(await dataSource.ToListAsync());
        return result;
    }

    /// <summary>單筆（Web API 的 GET {id}）；找不到或不在團隊範圍內時回 Id 為 0 的空資料。</summary>
    public async Task<__Name__AdapterModel> GetAsync(int id)
    {
        await using var context = await contextFactory.CreateDbContextAsync();
        var item = await context.__Name__.AsNoTracking().FirstOrDefaultAsync(x => x.Id == id);
#IF TEAMS
        if (item is null || !await IsVisibleAsync(item))
#ELSE
        if (item is null)
#ENDIF
        {
            return new __Name__AdapterModel();
        }

        return Mapper.Map<__Name__AdapterModel>(item);
    }

    public async Task<VerifyRecordResult> AddAsync(__Name__AdapterModel paraObject)
    {
        await using var context = await contextFactory.CreateDbContextAsync();
        try
        {
#IF TEAMS
            // 非管理員只能指定自己範圍內的團隊。
            if (RecordTeamScope.CheckAssignment(null, TagStringHelper.ToStored(paraObject.Teams), await accessScope.GetAsync()) is { } teamError)
            {
                Logger.LogInformation("__Name__ create rejected by team assignment rule.");
                return VerifyRecordResultFactory.Invalid(teamError);
            }

#ENDIF
            var item = Mapper.Map<__Name__>(paraObject);
            item.ConcurrencyStamp = ConcurrencyStampHelper.New();
            item.CreatedAt = DateTime.Now;
            item.UpdatedAt = DateTime.Now;

            await context.__Name__.AddAsync(item);
            await context.SaveChangesAsync();
            // 回填新的 Id 與版本號：Web API 新增後要回傳這一筆。
            paraObject.Id = item.Id;
            paraObject.ConcurrencyStamp = item.ConcurrencyStamp;

            Logger.LogInformation("__Name__ created. __Name__Id={__Name__Id}", item.Id);
            await WriteAuditAsync(AuditActions.__Name__.Create, item.Id, $"name={item.Name}");
            return VerifyRecordResultFactory.Build(true);
        }
        catch (Exception ex)
        {
            // 前置檢查與寫入不在同一個交易裡，唯一索引是最後一道防線；名稱重複是使用者情境，記 Information。
            if (UniqueConstraintHelper.TryGetFriendlyMessage(ex, out var conflictMessage))
            {
                Logger.LogInformation("__Name__ create rejected by unique constraint.");
                return VerifyRecordResultFactory.Conflict(conflictMessage, ex);
            }

            Logger.LogError(ex, "Failed to create __name__.");
            return VerifyRecordResultFactory.Error("新增__Item__失敗。", ex);
        }
    }

    public async Task<VerifyRecordResult> UpdateAsync(__Name__AdapterModel paraObject)
    {
        await using var context = await contextFactory.CreateDbContextAsync();
        try
        {
            var item = await context.__Name__.AsNoTracking().FirstOrDefaultAsync(x => x.Id == paraObject.Id);
            if (item == null)
            {
                return VerifyRecordResultFactory.NotFound("找不到要修改的__Item__資料。");
            }
#IF TEAMS

            if (!await IsVisibleAsync(item))
            {
                Logger.LogWarning("__Name__ update denied by team scope. __Name__Id={__Name__Id}", paraObject.Id);
                return VerifyRecordResultFactory.NotFound("這筆__Item__不在你的團隊範圍內，無法修改。");
            }

            if (RecordTeamScope.CheckAssignment(item.Teams, TagStringHelper.ToStored(paraObject.Teams), await accessScope.GetAsync()) is { } teamError)
            {
                Logger.LogInformation("__Name__ update rejected by team assignment rule. __Name__Id={__Name__Id}", paraObject.Id);
                return VerifyRecordResultFactory.Invalid(teamError);
            }
#ENDIF

            var itemData = Mapper.Map<__Name__>(paraObject);
            itemData.CreatedAt = item.CreatedAt;
            itemData.UpdatedAt = DateTime.Now;

            // 修改前後差異寫進稽核的詳細內容檔；item 是 AsNoTracking 讀出的修改前資料。
            var diff = AuditDiff.Compare(item, itemData).Render($"__Item__ #{itemData.Id}（{item.Name}）修改");

            var entry = context.Entry(itemData);
            entry.State = EntityState.Modified;
            ConcurrencyStampHelper.Apply(entry, paraObject.ConcurrencyStamp);
            SoftDeleteHelper.ProtectFlags(entry);
            await context.SaveChangesAsync();

            Logger.LogInformation("__Name__ updated. __Name__Id={__Name__Id}", itemData.Id);
            await WriteAuditAsync(AuditActions.__Name__.Update, itemData.Id, $"name={itemData.Name}", diff);
            return VerifyRecordResultFactory.Build(true);
        }
        catch (DbUpdateConcurrencyException ex)
        {
            // 別人在這段期間先存過或刪除了這筆：使用者情境而非系統錯誤，記 Information、不帶例外物件。
            Logger.LogInformation("__Name__ update rejected by concurrency conflict. __Name__Id={__Name__Id}", paraObject.Id);
            return VerifyRecordResultFactory.Conflict(ConcurrencyStampHelper.ConflictMessage, ex);
        }
        catch (Exception ex)
        {
            if (UniqueConstraintHelper.TryGetFriendlyMessage(ex, out var conflictMessage))
            {
                Logger.LogInformation("__Name__ update rejected by unique constraint. __Name__Id={__Name__Id}", paraObject.Id);
                return VerifyRecordResultFactory.Conflict(conflictMessage, ex);
            }

            Logger.LogError(ex, "Failed to update __name__. __Name__Id={__Name__Id}", paraObject.Id);
            return VerifyRecordResultFactory.Error("修改__Item__失敗。", ex);
        }
    }

    /// <summary>
    /// 清單上點狀態標籤切換啟用／停用：只改 IsEnabled，不走整筆覆寫的 UpdateAsync。參數是目標值；已經是目標值時回成功、不寫稽核。
    /// 換版本號：別人開著這筆的修改窗存檔時會得到並行衝突，而不是把狀態蓋回去。
    /// </summary>
    public async Task<VerifyRecordResult> SetEnabledAsync(int id, bool enabled)
    {
        await using var context = await contextFactory.CreateDbContextAsync();
        try
        {
            var item = await context.__Name__.AsNoTracking().FirstOrDefaultAsync(x => x.Id == id);
            if (item == null)
            {
                return VerifyRecordResultFactory.NotFound("找不到這筆__Item__，可能已被刪除。");
            }
#IF TEAMS

            if (!await IsVisibleAsync(item))
            {
                Logger.LogWarning("__Name__ status change denied by team scope. __Name__Id={__Name__Id}", id);
                return VerifyRecordResultFactory.NotFound("這筆__Item__不在你的團隊範圍內，無法修改。");
            }
#ENDIF

            var rows = item.IsEnabled == enabled ? 0 : await context.__Name__
                .Where(x => x.Id == id && x.IsEnabled != enabled)
                .ExecuteUpdateAsync(s => s
                    .SetProperty(x => x.IsEnabled, enabled)
                    .SetProperty(x => x.UpdatedAt, DateTime.Now)
                    .SetProperty(x => x.ConcurrencyStamp, ConcurrencyStampHelper.New()));
            if (rows == 0)
            {
                return VerifyRecordResultFactory.Build(true);
            }

            Logger.LogInformation("__Name__ status changed. __Name__Id={__Name__Id}, Enabled={Enabled}", id, enabled);
            await WriteAuditAsync(enabled ? AuditActions.__Name__.Enable : AuditActions.__Name__.Disable, id, $"name={item.Name}");
            return VerifyRecordResultFactory.Build(true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to change __name__ status. __Name__Id={__Name__Id}", id);
            return VerifyRecordResultFactory.Error("切換__Item__狀態失敗。", ex);
        }
    }

    /// <summary>刪除＝軟刪除：資料仍在，可在「顯示已刪除」還原；永久刪除見 <see cref="PurgeAsync"/>。</summary>
    public async Task<VerifyRecordResult> DeleteAsync(int id)
    {
        await using var context = await contextFactory.CreateDbContextAsync();
        try
        {
            var item = await context.__Name__.FirstOrDefaultAsync(x => x.Id == id);
            if (item == null)
            {
                return VerifyRecordResultFactory.NotFound("找不到要刪除的__Item__資料。");
            }
#IF TEAMS

            if (!await IsVisibleAsync(item))
            {
                Logger.LogWarning("__Name__ deletion denied by team scope. __Name__Id={__Name__Id}", id);
                return VerifyRecordResultFactory.NotFound("這筆__Item__不在你的團隊範圍內，無法刪除。");
            }
#ENDIF

            SoftDeleteHelper.MarkDeleted(item, currentUserService.CurrentUser.Id > 0 ? currentUserService.CurrentUser.Account : null);
            await context.SaveChangesAsync();

            Logger.LogInformation("__Name__ deleted. __Name__Id={__Name__Id}", id);
            await WriteAuditAsync(AuditActions.__Name__.Delete, id, $"name={item.Name}");
            return VerifyRecordResultFactory.Build(true);
        }
        catch (DbUpdateConcurrencyException ex)
        {
            Logger.LogInformation("__Name__ deletion rejected by concurrency conflict. __Name__Id={__Name__Id}", id);
            return VerifyRecordResultFactory.Conflict(ConcurrencyStampHelper.ConflictMessage, ex);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to delete __name__. __Name__Id={__Name__Id}", id);
            return VerifyRecordResultFactory.Error("刪除__Item__失敗。", ex);
        }
    }

    public async Task<VerifyRecordResult> RestoreAsync(int id)
    {
        await using var context = await contextFactory.CreateDbContextAsync();
        try
        {
            var item = await context.__Name__.IgnoreQueryFilters([ISoftDeletable.FilterName]).FirstOrDefaultAsync(x => x.Id == id && x.IsDeleted);
            if (item == null)
            {
                return VerifyRecordResultFactory.NotFound("找不到要還原的__Item__（可能已被還原或永久刪除）。");
            }
#IF TEAMS

            if (!await IsVisibleAsync(item))
            {
                Logger.LogWarning("__Name__ restore denied by team scope. __Name__Id={__Name__Id}", id);
                return VerifyRecordResultFactory.NotFound("這筆__Item__不在你的團隊範圍內，無法還原。");
            }
#ENDIF

            // 刪除期間可能有人建立了同名的資料（部分唯一索引允許），規則與新增時相同：不分大小寫。
            var name = item.Name.ToLower();
            if (await context.__Name__.AnyAsync(x => x.Id != id && x.Name.ToLower() == name))
            {
                return VerifyRecordResultFactory.Conflict($"已有同名的__Item__「{item.Name}」，無法還原。請先將現有的同名資料改名後再還原。");
            }

            SoftDeleteHelper.Restore(item);
            await context.SaveChangesAsync();

            Logger.LogInformation("__Name__ restored. __Name__Id={__Name__Id}", id);
            await WriteAuditAsync(AuditActions.__Name__.Restore, id, $"name={item.Name}");
            return VerifyRecordResultFactory.Build(true);
        }
        catch (DbUpdateConcurrencyException ex)
        {
            Logger.LogInformation("__Name__ restore rejected by concurrency conflict. __Name__Id={__Name__Id}", id);
            return VerifyRecordResultFactory.Conflict(ConcurrencyStampHelper.ConflictMessage, ex);
        }
        catch (Exception ex)
        {
            if (UniqueConstraintHelper.TryGetFriendlyMessage(ex, out var conflictMessage))
            {
                return VerifyRecordResultFactory.Conflict(conflictMessage, ex);
            }

            Logger.LogError(ex, "Failed to restore __name__. __Name__Id={__Name__Id}", id);
            return VerifyRecordResultFactory.Error("還原__Item__失敗。", ex);
        }
    }

    /// <summary>永久刪除：只能對已刪除的資料執行，無法復原。</summary>
    public async Task<VerifyRecordResult> PurgeAsync(int id)
    {
        await using var context = await contextFactory.CreateDbContextAsync();
        try
        {
            var item = await context.__Name__.IgnoreQueryFilters([ISoftDeletable.FilterName]).FirstOrDefaultAsync(x => x.Id == id && x.IsDeleted);
            if (item == null)
            {
                return VerifyRecordResultFactory.NotFound("找不到要永久刪除的__Item__（只能永久刪除已刪除的資料）。");
            }
#IF TEAMS

            if (!await IsVisibleAsync(item))
            {
                Logger.LogWarning("__Name__ purge denied by team scope. __Name__Id={__Name__Id}", id);
                return VerifyRecordResultFactory.NotFound("這筆__Item__不在你的團隊範圍內，無法永久刪除。");
            }
#ENDIF

            context.__Name__.Remove(item);
            await context.SaveChangesAsync();

            Logger.LogInformation("__Name__ purged. __Name__Id={__Name__Id}", id);
            await WriteAuditAsync(AuditActions.__Name__.Purge, id, $"name={item.Name}");
            return VerifyRecordResultFactory.Build(true);
        }
        catch (DbUpdateConcurrencyException ex)
        {
            Logger.LogInformation("__Name__ purge rejected by concurrency conflict. __Name__Id={__Name__Id}", id);
            return VerifyRecordResultFactory.Conflict("這筆__Item__已被其他人還原或變更，沒有執行永久刪除。", ex);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to purge __name__. __Name__Id={__Name__Id}", id);
            return VerifyRecordResultFactory.Error("永久刪除__Item__失敗。", ex);
        }
    }

    /// <summary>新增前檢查名稱是否重複（先正規化、再不分大小寫；含其他團隊看不到的資料）。</summary>
    public async Task<VerifyRecordResult> BeforeAddCheckAsync(__Name__AdapterModel paraObject)
    {
        await using var context = await contextFactory.CreateDbContextAsync();
        var name = NameNormalizer.Normalize(paraObject.Name).ToLower();
        return await context.__Name__.AsNoTracking().AnyAsync(x => x.Name.ToLower() == name)
            ? VerifyRecordResultFactory.Conflict("名稱已存在，無法新增。")
            : VerifyRecordResultFactory.Build(true);
    }

    public async Task<VerifyRecordResult> BeforeUpdateCheckAsync(__Name__AdapterModel paraObject)
    {
        await using var context = await contextFactory.CreateDbContextAsync();
        if (!await context.__Name__.AsNoTracking().AnyAsync(x => x.Id == paraObject.Id))
        {
            return VerifyRecordResultFactory.NotFound("要修改的__Item__資料不存在。");
        }

        var name = NameNormalizer.Normalize(paraObject.Name).ToLower();
        return await context.__Name__.AsNoTracking().AnyAsync(x => x.Name.ToLower() == name && x.Id != paraObject.Id)
            ? VerifyRecordResultFactory.Conflict("名稱已存在，無法修改。")
            : VerifyRecordResultFactory.Build(true);
    }
}
