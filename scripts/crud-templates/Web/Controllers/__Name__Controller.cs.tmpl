using Microsoft.AspNetCore.Authentication.JwtBearer;
using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;
using MyProject.Business.Helpers;
using MyProject.Business.Services.DataAccess;
using MyProject.Business.Services.Other;
using MyProject.Dtos.Commons;
using MyProject.Dtos.Models;
using MyProject.Models.AdapterModel;
using MyProject.Models.Systems;
using MyProject.Share.Helpers;
using MyProject.Web.Auth;
using MyProject.Web.Client.Api;
using MyProject.Web.Components.Commons;
using MyProject.Web.Export;
using MyProject.Web.Filters;

namespace MyProject.Web.Controllers;

/// <summary>
/// __Display__的 Web API（由 scripts/New-CrudModule.ps1 產生）。WASM 頁面只用這組端點；一律回 <c>ApiResult</c>，
/// 每個端點以 [HasPermission] 做動作級授權。規則、並行衝突、軟刪除與稽核都在 <see cref="__Name__Service"/>（與畫面共用一份），
/// 失敗依種類回 404／409／400／500（<see cref="ControllerVerifyResultExtensions.FromVerify(ControllerBase, VerifyRecordResult, string)"/>）。
/// </summary>
[Route("api/[controller]")]
[Route("api/v1/[controller]")]
[ApiController]
[ApiValidationFilter]
[Authorize(AuthenticationSchemes = JwtBearerDefaults.AuthenticationScheme)]
public class __Name__Controller : ControllerBase
{
    private const string TargetType = "__Name__";

    private static readonly string[] SortableFields =
    [
        nameof(__Name__AdapterModel.Name),
        nameof(__Name__AdapterModel.IsEnabled),
        nameof(__Name__AdapterModel.CreatedAt),
        nameof(__Name__AdapterModel.UpdatedAt),
    ];

    /// <summary>匯出 Excel 的欄位。</summary>
    internal static readonly IReadOnlyList<ExportColumn<__Name__AdapterModel>> ExportColumns =
    [
        new("名稱", x => x.Name, Width: 24),
        new("描述", x => x.Description, Width: 40),
#IF TEAMS
        new("團隊", x => x.TeamsText, Width: 24),
#ENDIF
        new("啟用", x => x.IsEnabled, Width: 8),
        new("建立時間", x => x.CreatedAt, TabularExport.DateTimeFormat, 18),
        new("更新時間", x => x.UpdatedAt, TabularExport.DateTimeFormat, 18),
        new("刪除時間", x => x.DeletedAt, TabularExport.DateTimeFormat, 18),
        new("刪除者", x => x.DeletedBy, Width: 14),
    ];

    private readonly ILogger<__Name__Controller> logger;
    private readonly __Name__Service service;
#IF TEAMS
    private readonly TeamService teamService;
    private readonly IRecordAccessScopeProvider accessScope;
#ENDIF
    private readonly IAuditLogService auditLogService;
    private readonly CurrentUserService currentUserService;

    public __Name__Controller(
        ILogger<__Name__Controller> logger,
        __Name__Service service,
#IF TEAMS
        TeamService teamService,
        IRecordAccessScopeProvider accessScope,
#ENDIF
        IAuditLogService auditLogService,
        CurrentUserService currentUserService)
    {
        this.logger = logger;
        this.service = service;
#IF TEAMS
        this.teamService = teamService;
        this.accessScope = accessScope;
#ENDIF
        this.auditLogService = auditLogService;
        this.currentUserService = currentUserService;
    }

    /// <summary>單筆（WASM 頁開修改窗時呼叫，拿到最新的版本號）；寫一筆「查看」稽核。</summary>
    [HttpGet("{id}")]
    [HasPermission(MagicObjectHelper.__PermConst__, PermissionActions.View)]
    public async Task<ActionResult<ApiResult<__Name__Dto>>> GetById(int id)
    {
        var item = await service.GetAsync(id);
        if (item.Id == 0)
        {
            return NotFound(ApiResult<__Name__Dto>.NotFoundResult($"找不到 ID 為 {id} 的__Item__"));
        }

        await ViewAudit.WriteAsync(auditLogService, currentUserService, AuditActions.__Name__.View, TargetType,
            id.ToString(System.Globalization.CultureInfo.InvariantCulture), $"name={item.Name}");
        return Ok(ApiResult<__Name__Dto>.SuccessResult(__Name__DtoMapper.ToDto(item), "取得__Item__成功"));
    }

    /// <summary>清單（含「顯示已刪除」）；RecordSearch 為 true 時寫一筆搜尋稽核。</summary>
    [HttpPost("search")]
    [HasPermission(MagicObjectHelper.__PermConst__, PermissionActions.View)]
    public async Task<ActionResult<ApiResult<PagedResult<__Name__Dto>>>> Search([FromBody] __Name__SearchRequestDto request)
    {
        if (ForbidDeletedList(request.Deleted) is { } forbidden)
        {
            return forbidden;
        }

        var dataRequest = ToDataRequest(request);
        var result = request.Deleted ? await service.GetDeletedAsync(dataRequest) : await service.GetAsync(dataRequest, request.IsEnabled);
        if (request.RecordSearch)
        {
            await ViewAudit.WriteSearchAsync(auditLogService, currentUserService, AuditActions.__Name__.Search, TargetType,
                AuditSearchCondition.Text("keyword", request.Keyword), AuditSearchCondition.Of("showDeleted", request.Deleted));
        }

        return Ok(ApiResult<PagedResult<__Name__Dto>>.SuccessResult(new PagedResult<__Name__Dto>
        {
            Items = result.Result.Select(__Name__DtoMapper.ToDto).ToList(),
            TotalCount = result.Count,
            PageIndex = request.PageIndex,
            PageSize = request.PageSize,
            TotalPages = (int)Math.Ceiling(result.Count / (double)request.PageSize),
        }, "搜尋__Item__成功"));
    }
#IF TEAMS

    /// <summary>表單「團隊」的選項：啟用中的團隊名稱與自己的團隊範圍。</summary>
    [HttpGet("options")]
    [HasPermission(MagicObjectHelper.__PermConst__, PermissionActions.View)]
    public async Task<ActionResult<ApiResult<CategoryFormOptionsDto>>> Options()
    {
        var scope = await accessScope.GetAsync();
        return Ok(ApiResult<CategoryFormOptionsDto>.SuccessResult(new CategoryFormOptionsDto
        {
            Teams = await teamService.GetAllEnabledNamesAsync(),
            IsAdmin = scope.IsAdmin,
            MyTeams = scope.Teams.ToList(),
        }, "取得表單選項成功"));
    }
#ENDIF

    /// <summary>存檔前的名稱檢查；Id 有值時是修改（要有修改權限，範圍外的回 404），否則是新增（要有新增權限）。</summary>
    [HttpPost("check")]
    [HasPermission(MagicObjectHelper.__PermConst__, PermissionActions.View)]
    public async Task<ActionResult<ApiResult>> Check([FromBody] __Name__CreateUpdateDto dto)
    {
        var model = __Name__DtoMapper.ToModel(dto);
        var action = model.Id > 0 ? PermissionActions.Edit : PermissionActions.Create;
        if (this.ForbidUnless(PermissionRules.CanAccessAction(currentUserService.CurrentUser, MagicObjectHelper.__PermConst__, action), "你沒有權限儲存__Item__。") is { } forbidden)
        {
            return forbidden;
        }

        if (model.Id > 0 && (await service.GetAsync(model.Id)).Id == 0)
        {
            return NotFound(ApiResult.NotFoundResult($"找不到 ID 為 {model.Id} 的__Item__"));
        }

        var result = model.Id > 0 ? await service.BeforeUpdateCheckAsync(model) : await service.BeforeAddCheckAsync(model);
        return this.FromVerify(result, "可以儲存");
    }

    [HttpPost]
    [HasPermission(MagicObjectHelper.__PermConst__, PermissionActions.Create)]
    public async Task<ActionResult<ApiResult<__Name__Dto>>> Create([FromBody] __Name__CreateUpdateDto dto)
    {
        var model = __Name__DtoMapper.ToModel(dto);
        model.Id = 0;

        // 名稱重複先擋（去空白、不分大小寫）；唯一索引只比對原字串，大小寫不同擋不下。
        var check = await service.BeforeAddCheckAsync(model);
        if (!check.Success)
        {
            return this.FromVerify<__Name__Dto>(check, () => null!, string.Empty);
        }

        return this.FromVerify(await service.AddAsync(model), () => __Name__DtoMapper.ToDto(model), "新增__Item__成功");
    }

    [HttpPut("{id}")]
    [HasPermission(MagicObjectHelper.__PermConst__, PermissionActions.Edit)]
    public async Task<ActionResult<ApiResult>> Update(int id, [FromBody] __Name__CreateUpdateDto dto)
    {
        if (id != dto.Id)
        {
            return BadRequest(ApiResult.ValidationError("路由 ID 與資料 ID 不一致"));
        }

        // 樂觀並行：PUT 必須帶上 GET 取得的版本號，否則無法判斷是否覆蓋了別人的修改。
        if (string.IsNullOrWhiteSpace(dto.ConcurrencyStamp))
        {
            return BadRequest(ApiResult.ValidationError("ConcurrencyStamp 為必填：請帶上 GET 取得的版本號（用來避免覆蓋別人的修改）。"));
        }

        var model = __Name__DtoMapper.ToModel(dto);

        // 先看範圍再比對名稱：範圍外的一律 404，不會因為名稱重複回 409 而透露它存在。
        if ((await service.GetAsync(id)).Id == 0)
        {
            return NotFound(ApiResult.NotFoundResult($"找不到 ID 為 {id} 的__Item__"));
        }

        var check = await service.BeforeUpdateCheckAsync(model);
        if (!check.Success)
        {
            return this.FromVerify(check, string.Empty);
        }

        return this.FromVerify(await service.UpdateAsync(model), "更新__Item__成功");
    }

    /// <summary>點狀態標籤切換啟用／停用（只改狀態，換版本號）。</summary>
    [HttpPut("{id:int}/enabled")]
    [HasPermission(MagicObjectHelper.__PermConst__, PermissionActions.Edit)]
    public async Task<ActionResult<ApiResult>> SetEnabled(int id, [FromBody] SetEnabledRequestDto request)
        => this.FromVerify(await service.SetEnabledAsync(id, request.Enabled), request.Enabled ? "已啟用" : "已停用");

    /// <summary>軟刪除：可在「顯示已刪除」中還原或永久刪除。</summary>
    [HttpDelete("{id}")]
    [HasPermission(MagicObjectHelper.__PermConst__, PermissionActions.Delete)]
    public async Task<ActionResult<ApiResult>> Delete(int id)
        => this.FromVerify(await service.DeleteAsync(id), "刪除__Item__成功");

    [HttpPost("{id:int}/restore")]
    [HasPermission(MagicObjectHelper.__PermConst__, PermissionActions.Delete)]
    public async Task<ActionResult<ApiResult>> Restore(int id)
        => this.FromVerify(await service.RestoreAsync(id), "還原成功");

    /// <summary>永久刪除：只能對已刪除的資料執行。</summary>
    [HttpDelete("{id:int}/purge")]
    [HasPermission(MagicObjectHelper.__PermConst__, PermissionActions.Delete)]
    public async Task<ActionResult<ApiResult>> Purge(int id)
        => this.FromVerify(await service.PurgeAsync(id), "已永久刪除");

    /// <summary>匯出 Excel：與清單同一個查詢，超過上限筆數回 400 與原因；寫一筆匯出稽核。</summary>
    [HttpPost("export")]
    [HasPermission(MagicObjectHelper.__PermConst__, PermissionActions.View)]
    public async Task<IActionResult> Export([FromBody] __Name__SearchRequestDto request)
    {
        if (ForbidDeletedList(request.Deleted) is { } forbidden)
        {
            return forbidden;
        }

        var outcome = await BusinessExports.BuildAsync(
            r => request.Deleted ? service.GetDeletedAsync(r) : service.GetAsync(r, request.IsEnabled),
            ToDataRequest(request), "__Item__", "__RouteKey__", ExportColumns);
        if (outcome.Error is { } error)
        {
            return BadRequest(ApiResult.ValidationError(error));
        }

        logger.LogInformation("__Name__ export downloaded. Rows={Rows}", outcome.Rows);
        await BusinessExports.WriteAuditAsync(auditLogService, currentUserService, AuditActions.__Name__.Export, TargetType, outcome.Rows, request.Deleted);
        return File(outcome.Content!, TabularExport.XlsxContentType, outcome.FileName);
    }

    /// <summary>「顯示已刪除」與畫面相同，要有刪除權限。</summary>
    private ObjectResult? ForbidDeletedList(bool deleted)
        => deleted
            ? this.ForbidUnless(PermissionRules.CanAccessAction(currentUserService.CurrentUser, MagicObjectHelper.__PermConst__, PermissionActions.Delete), "檢視已刪除的__Item__需要刪除權限。")
            : null;

    private static DataRequest ToDataRequest(__Name__SearchRequestDto request)
    {
        var sortField = ControllerVerifyResultExtensions.ResolveSortField<__Name__AdapterModel>(request.SortBy, SortableFields);
        return new DataRequest
        {
            Search = request.Keyword ?? string.Empty,
            SortField = sortField ?? string.Empty,
            SortDescending = sortField is null ? null : request.SortDescending,
            CurrentPage = request.PageIndex,
            PageSize = request.PageSize,
            Take = request.PageSize,
        };
    }
}
