{
  // ════════════════════════════════════════════════════════════════════════════
  // 設定檔說明（每個屬性行尾都有註解；完整說明見 docs/operations/日誌與設定檔說明.md §4）
  //
  // 標記：
  //   ⚠️【正式必改】 正式環境要改：在 appsettings.Production.json 寫同樣的路徑覆蓋這裡的值。
  //   🔒【機密】     有用到就一律用環境變數提供（名稱寫在註解裡，例如 JwtSettings__SigningKey），
  //                  不要寫進任何 json 檔；開發機用 User Secrets。其中 SigningKey、SupportPassword
  //                  在 appsettings.Production.json 已清空，正式環境沒設環境變數網站不會啟動。
  //   註解寫「要用…時」的，只有啟用那個功能才需要處理。
  //   陣列（例如 Cors:AllowedOrigins）是逐項合併、不是整個取代：覆蓋時寫比較短的陣列，清不掉這裡多出來的項目。
  //
  // 覆蓋順序（後面的蓋前面）：appsettings.json → appsettings.{環境}.json → User Secrets（只在 Development）
  //   → 環境變數 → 命令列參數 → 「系統參數」頁（資料庫，只限頁面上列出的項目）。
  // 註解寫「系統參數頁可改」的項目在畫面上調整不必重啟，何時開始作用見頁面說明；這裡只是預設值。
  // 頁面上存過值以後，改這裡或環境變數都不會生效，要先在頁面上把該項還原成設定檔的值。
  // 新增設定時一定要加行尾註解（AppSettingsCommentConventionTests 會檢查）。
  // ════════════════════════════════════════════════════════════════════════════

  // ████████████████████████████████████████████████████████████████████████████
  // 第一部分：正式環境要處理的設定（有 ⚠️【正式必改】或 🔒【機密】標記，區段內有標記的屬性排在最上面）
  // ████████████████████████████████████████████████████████████████████████████

  // ════ 一、一定要處理：不處理就不能上線 ════

  // ── 系統基本資料與檔案位置 ──
  // 啟動時驗證：路徑都必須是完整路徑，寫錯網站不會啟動；路徑改了要重新啟動。
  "SystemSettings": {
    // 12 個資料目錄：不存在時啟動會自動建立；應用程式集區帳號要有讀寫權限。
    // 系統備份會打包資料庫快照與 ProjectFile、Exception、TokenUsage、AuditContent、Keys（AI 兩類可選），不打包 Download、Upload、AuditKey。
    "ExternalFileSystem": {
      "DatabasePath": "C:\\temp\\MyProject\\DB",   // ⚠️【正式必改】SQLite 資料庫檔所在資料夾
      "DownloadPath": "C:\\temp\\MyProject\\Download",   // ⚠️【正式必改】下載用的暫存資料夾（0.10.8 起不再以 /UploadFiles 網址直接提供）
      "UploadPath": "C:\\temp\\MyProject\\Upload",   // ⚠️【正式必改】通用上傳暫存資料夾
      "ProjectFilePath": "C:\\temp\\MyProject\\ProjectFile",   // ⚠️【正式必改】專案附件（依年/月分層）
      "ExceptionPath": "C:\\temp\\MyProject\\Exception",   // ⚠️【正式必改】系統例外的完整堆疊檔
      "TokenUsagePath": "C:\\temp\\MyProject\\TokenUsage",   // ⚠️【正式必改】AI 用量的原始 usage 檔（只有用量，不含提示詞與回應）
      "AiCallLogPath": "C:\\temp\\MyProject\\AiCallLog",   // ⚠️【正式必改】AI 對話紀錄內容檔（含日誌與例外內容，只給管理員；不可放在 DownloadPath 底下）
      "AiAgentConversationPath": "C:\\temp\\MyProject\\AiAgentConversation",   // ⚠️【正式必改】Agent 對話、工作流程紀錄與巡檢報告（不可放在 DownloadPath 底下）
      "AuditContentPath": "C:\\temp\\MyProject\\AuditContent",   // ⚠️【正式必改】稽核的修改差異與查詢條件檔（可能含個資；不可放在 DownloadPath 底下）
      "DataProtectionKeyPath": "C:\\temp\\MyProject\\Keys",   // ⚠️【正式必改】資料保護金鑰（加密兩步驟驗證密鑰、記住裝置與兩步驟驗證票證）：遺失或換掉，開了兩步驟驗證的人無法登入、記住的裝置要重新驗證；多台主機要共用
      "BackupPath": "C:\\temp\\MyProject\\Backup",   // ⚠️【正式必改】系統備份 zip 存放處；不可與其他資料目錄重疊、不可在網站目錄底下
      "AuditKeyPath": "C:\\temp\\MyProject\\AuditKey"   // ⚠️【正式必改】稽核防竄改金鑰（刻意不進備份，請另外離線保存一份）；必須是獨立資料夾
    },
    "SystemInformation": {
      "SystemName": "企業管理平台",   // 登入頁、側邊欄、分頁標題、PDF 與信件顯示的系統名稱（系統參數頁可改）
      "SystemDescription": "以模組化結構、權限控管與後台管理流程，協助團隊快速建立企業內部系統。",   // 登入頁、首頁與「關於」的一句話說明（系統參數頁可改）
      "SystemVersion": "0.10.20 (2026/11/14)"   // 唯一的版本來源，格式「主.次.修 (年/月/日)」；有建置內容的異動才把最後一碼加 1
    },
    "ConnectionStrings": {
      "SQLiteDefaultConnection": "Data Source=BackendDB.db"   // 沒有作用（程式不讀）：資料庫檔固定是 DatabasePath 底下的 BackendDB.db；要搬資料庫請改 DatabasePath
    }
  },

  // ── 日誌（NLog）──
  // 這不是 NLog 設定本身（規則在 nlog.config），只放日誌根目錄；改了要重新啟動。
  "NLog": {
    "BasePath": "C:\\temp\\Logs"   // ⚠️【正式必改】日誌檔根目錄，底下會建 MyProject.Web 子資料夾；檔案保留 30 天
  },

  // ── 允許的主機名稱 ──
  "AllowedHosts": "*",   // ⚠️【正式必改】允許的主機名稱，多個用分號隔開；* 表示不檢查，正式環境建議填實際網域（例如 erp.example.com）

  // ── 內建管理員 support ──
  // 每次啟動：support 不存在就建立；已存在則把密碼重設成這裡的值（在畫面上改密碼沒用，重新啟動就改回來，並踢掉 support 的登入），
  // 且強制為管理員。姓名、Email 只在第一次建立時寫入。上線後再改 SupportAccount 會另外建一個新管理員，舊帳號還在。
  "BootstrapSettings": {
    "SupportEmail": "support",   // ⚠️【正式必改】內建管理員的 Email（只在第一次建立帳號時寫入）；請改成真的信箱，管理員通知才寄得到
    "SupportPassword": "support",   // 🔒【機密】內建管理員密碼，這個值只能開發用；正式環境用環境變數 BootstrapSettings__SupportPassword（不要放 User Secrets）
    "SupportAccount": "support",   // 內建管理員帳號（不可留空）；這個帳號不會被刪除，也不受兩步驟驗證與密碼到期強制
    "SupportName": "support"   // 內建管理員的顯示名稱（只在第一次建立帳號時寫入）
  },

  // ── Web API 權杖（JWT）──
  // 只影響 /api；整個區段改了都要重新啟動。
  "JwtSettings": {
    "SigningKey": "DevelopmentOnly-ChangeThisJwtSigningKey-AtLeast32Chars",   // 🔒【機密】簽章金鑰，至少 32 字的隨機字串；這個值只能開發用，正式環境用環境變數 JwtSettings__SigningKey（換掉會讓所有既有權杖失效）
    "Issuer": "MyProject",   // 權杖發行者名稱（必填）
    "Audience": "MyProject.WebApi",   // 權杖接收者名稱（必填）
    "AccessTokenMinutes": 60,   // 存取權杖效期（分鐘，1～1440）
    "RefreshTokenDays": 7,   // 更新權杖效期（天，1～365）
    "ClockSkewMinutes": 2   // 驗證時容許的時鐘誤差（分鐘，0～60）
  },

  // ── Swagger、例外細節、CORS ──
  // 這三個區段在 appsettings.Production.json 已有正式環境的值，確認符合需要即可。
  "Swagger": {
    "EnabledInProduction": false   // ⚠️【正式必改】正式環境是否開放 Swagger UI（Production.json 已設 false，勿刪）
  },

  "Security": {
    "ReturnExceptionDetails": null   // ⚠️【正式必改】API 錯誤回應是否附完整例外；null＝只有開發環境附（Production.json 已設 false，勿刪）
  },

  "Cors": {
    "AllowedOrigins": []   // ⚠️【正式必改】前端以外還有別的網站要跨網域呼叫 /api 時才填，例如 ["https://other.example.com"]；空＝不開放（Production.json 已設 []）。前端的網址填 ClientSettings:BaseUrl 就會自動允許
  },

  // ── 前端網址（0.10.10 起）──
  // 前端（MyProject.Web.Client）是獨立的靜態站台時才填；同站台部署（這個網站一併提供前端）留空。寫錯網站不會啟動。
  "ClientSettings": {
    "BaseUrl": ""   // ⚠️【正式必改】前端另外部署成獨立站台時填它的網址，例如 https://app.example.com/（正式環境必須 https）：這個網站就只提供 API、允許它跨網域呼叫，Google 登入與信中連結都導回它；留空＝同站台
  },

  // ════ 二、有用到才要處理：啟用該功能時才需要設定 ════

  // ── 寄信 ──
  // 寫錯網站不會啟動。正式環境若要寄信：Provider 設 Smtp，Host、FromAddress、PublicBaseUrl 必填（不可用 Pickup）。
  // Gmail 的設定步驟見 docs/operations/Gmail寄信設定指南.md。
  "EmailSettings": {
    "Provider": "None",   // ⚠️【正式必改】要寄信時改成 Smtp。None＝不寄；Pickup＝存成 .eml 檔（只限開發，正式環境不會啟動）
    "Host": "",   // ⚠️【正式必改】要寄信時填 SMTP 主機，例如 smtp.gmail.com
    "FromAddress": "",   // ⚠️【正式必改】要寄信時填寄件者 Email
    "PublicBaseUrl": "",   // ⚠️【正式必改】要寄信時填網站對外網址，例如 https://erp.example.com；信中連結以它為準
    "UserName": "",   // 🔒【機密】SMTP 登入帳號，留空＝不登入（內網中繼）；正式環境用環境變數 EmailSettings__UserName
    "Password": "",   // 🔒【機密】SMTP 密碼（Gmail 用應用程式密碼）；正式環境用環境變數 EmailSettings__Password
    "Port": 587,   // SMTP 連接埠（587 搭配 StartTls、465 搭配 SslOnConnect）
    "Security": "StartTls",   // 加密方式：Auto、None、StartTls、SslOnConnect
    "FromName": "",   // 寄件者顯示名稱，留空用系統名稱
    "PickupDirectory": "C:\\temp\\MyProject\\Mails",   // Provider 為 Pickup 時 .eml 的存放資料夾（只限開發）
    "TimeoutSeconds": 30   // 單一網路操作的逾時秒數（1～300）
  },

  // ── AI 連線 ──
  // ApiKey 有填才啟用 AI 功能（沒有另外的開關）；填了金鑰卻缺 Model（Azure 再加 Endpoint），任何環境都不會啟動。
  "AiSettings": {
    "Endpoint": "",   // ⚠️【正式必改】要用 AI 時填。Azure 填入口網站的「Azure OpenAI 端點」（…/openai/v1）；OpenAI 留空即可
    "Model": "",   // ⚠️【正式必改】要用 AI 時填。Azure 填部署名稱、OpenAI 填模型 id，都不要帶日期後綴；各功能可在系統參數頁另選模型
    "ApiKey": "",   // 🔒【機密】AI 服務金鑰，留空＝AI 功能關閉；正式環境用環境變數 AiSettings__ApiKey
    "Provider": "AzureOpenAI",   // AI 服務：AzureOpenAI 或 OpenAI（不分大小寫）
    "TimeoutSeconds": 600   // 每次呼叫 AI 的逾時秒數（1～3600，超出範圍網站不會啟動；推論模型可能想很久）
  },

  // ── Google 第三方登入 ──
  // 設定步驟見 docs/security/Google OAuth2 第三方登入.md；改了要重新啟動。
  // Enabled 為 true 時 ClientId、ClientSecret、DefaultRoleName 都必填，否則任何環境都不會啟動。
  "GoogleOAuthSettings": {
    "Enabled": false,   // ⚠️【正式必改】要用 Google 登入時改成 true（false 時登入頁不顯示按鈕）
    "ClientId": "",   // ⚠️【正式必改】要用 Google 登入時填 Google Cloud 的用戶端 ID
    "ClientSecret": "",   // 🔒【機密】Google 用戶端密碼；正式環境用環境變數 GoogleOAuthSettings__ClientSecret
    "DefaultRoleName": "預設角色"   // 第一次用 Google 登入而自動建立的帳號套用的角色名稱
  },

  // ── 快取 ──
  // 寫錯網站不會啟動；改了要重新啟動。
  "CacheSettings": {
    "RedisConnection": "",   // 🔒【機密】Provider 為 Redis 時的連線字串（常含密碼）；正式環境用環境變數 CacheSettings__RedisConnection
    "Provider": "Memory",   // Memory（單機記憶體）或 Redis（多台主機共用）；空字串視為 Memory
    "InstanceName": "MyProject:",   // Redis 鍵的前綴，同一台 Redis 放多個系統時用來區隔
    "DefaultExpirationMinutes": 30   // 沒指定過期時間時的預設快取分鐘數
  },

  // ── AutoMapper 授權 ──
  "AutoMapper:LicenseKey": "",   // 🔒【機密】AutoMapper 商業授權金鑰，留空時啟動日誌會出現授權警告；正式商用前請確認授權，用環境變數 AutoMapper__LicenseKey

  // ████████████████████████████████████████████████████████████████████████████
  // 第二部分：一般設定（可以直接用預設值；註解寫「系統參數頁可改」的也可在畫面上調整）
  // ████████████████████████████████████████████████████████████████████████████

  // ── 網頁登入能維持多久（0.10.8 起取代 CookieSettings；舊鍵仍相容，啟動時會記警告提醒改名）──
  // 寫錯網站不會啟動；改了要重新啟動。App 與整合程式以 API 登入時看 JwtSettings。
  "SessionSettings": {
    "IdleTimeoutMinutes": 480,   // 沒勾「記住我」時多久沒使用就要重新登入（分鐘，1～43200，每次使用重新起算），關掉分頁也會登出
    "IdleTimeoutSliding": true,   // true：每次使用重新起算；false：從登入起最多 IdleTimeoutMinutes 分鐘（一直使用也會到期；對應舊的 CookieSettings:SlidingExpiration）
    "RememberMeDays": 30,   // 勾了「記住我」時整個登入最長幾天（1～365，從登入那一刻算）
    "AccessTokenMinutes": 15,   // 網頁的存取權杖效期（分鐘，1～1440），到期前畫面自動換新
    "ValidationIntervalMinutes": 5   // 改密碼、停用、強制登出後，其他主機最晚幾分鐘內看到（1～60）；同一台主機是立即的，調小會多查資料庫
  },

  // ── AI 計費 ──
  // 費用在呼叫當下算好存進 Token 用量（快照），改這裡只影響之後的呼叫。更新費率請照 docs/operations/AI模型計費更新指南.md。
  // Models 的鍵是模型名稱（不分大小寫；帶日期或版本後綴的名稱會對到前綴，例如 gpt-6-astra-2026-03-01 → gpt-6-astra）。
  //   Azure 成功的呼叫記的是回應裡的模型名稱，失敗時才退回部署名稱；要讓失敗的呼叫也能計價，就再加一筆部署名稱。
  //   LongContextThresholdTokens：輸入 token 超過這個數就改用 LongContextRates（沒有 LongContextRates 的模型不分級）
  //   Rates／LongContextRates 的欄位（美元）：Text／Image 的 Input、CachedInput、Output 都是每 100 萬 token；
  //   AudioPerMinute 是音訊每分鐘；SpeechPerMillionCharacters 是語音合成每 100 萬字元。
  // 沒列在這裡的模型記為「未定價」（費用 0，也不計入 AI 用量上限）。
  "AiPricingSettings": {
    "UsdToTwd": 31.5,   // 1 美元折合多少台幣，必須大於 0（填 0 或負數網站不會啟動）
    "Models": {
      "gpt-6-astra": {
        "LongContextThresholdTokens": 272000,   // 輸入 token 嚴格大於這個數就改用 LongContextRates
        "Rates": {
          "TextInputPerMillion": 10.0,   // 文字輸入，每 100 萬 token 美元
          "TextCachedInputPerMillion": 1.0,   // 文字輸入中快取命中的部分，每 100 萬 token 美元
          "TextOutputPerMillion": 50.0   // 文字輸出，每 100 萬 token 美元
        },
        "LongContextRates": {
          "TextInputPerMillion": 20.0,   // 長脈絡時的文字輸入單價
          "TextCachedInputPerMillion": 2.0,   // 長脈絡時的快取命中單價
          "TextOutputPerMillion": 75.0   // 長脈絡時的文字輸出單價
        }
      },
      "gpt-6.1-sol": {
        "LongContextThresholdTokens": 272000,
        "Rates": {
          "TextInputPerMillion": 2.0,
          "TextCachedInputPerMillion": 0.1,
          "TextOutputPerMillion": 10.0
        },
        "LongContextRates": {
          "TextInputPerMillion": 4.0,
          "TextCachedInputPerMillion": 0.2,
          "TextOutputPerMillion": 15.0
        }
      },
      "gpt-6-sol": {
        "LongContextThresholdTokens": 272000,
        "Rates": {
          "TextInputPerMillion": 2.0,
          "TextCachedInputPerMillion": 0.2,
          "TextOutputPerMillion": 10.0
        },
        "LongContextRates": {
          "TextInputPerMillion": 4.0,
          "TextCachedInputPerMillion": 0.4,
          "TextOutputPerMillion": 15.0
        }
      },
      "gpt-6-luna": {
        "LongContextThresholdTokens": 272000,
        "Rates": {
          "TextInputPerMillion": 0.1,
          "TextCachedInputPerMillion": 0.01,
          "TextOutputPerMillion": 0.5
        },
        "LongContextRates": {
          "TextInputPerMillion": 0.2,
          "TextCachedInputPerMillion": 0.02,
          "TextOutputPerMillion": 0.75
        }
      },
      "gpt-5.6-sol": {
        "LongContextThresholdTokens": 272000,
        "Rates": {
          "TextInputPerMillion": 4.0,
          "TextCachedInputPerMillion": 0.4,
          "TextOutputPerMillion": 20.0
        },
        "LongContextRates": {
          "TextInputPerMillion": 8.0,
          "TextCachedInputPerMillion": 0.8,
          "TextOutputPerMillion": 30.0
        }
      },
      "gpt-5.6-terra": {
        "LongContextThresholdTokens": 272000,
        "Rates": {
          "TextInputPerMillion": 2.0,
          "TextCachedInputPerMillion": 0.2,
          "TextOutputPerMillion": 12.0
        },
        "LongContextRates": {
          "TextInputPerMillion": 4.0,
          "TextCachedInputPerMillion": 0.4,
          "TextOutputPerMillion": 18.0
        }
      },
      "gpt-5.6-luna": {
        "LongContextThresholdTokens": 272000,
        "Rates": {
          "TextInputPerMillion": 0.2,
          "TextCachedInputPerMillion": 0.02,
