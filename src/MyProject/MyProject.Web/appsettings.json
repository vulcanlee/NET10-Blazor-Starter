  },

  // ── 系統管理助理巡檢報告 ──
  // 巡檢時間在 ScheduledJobSettings:Jobs:AdminPatrol。
  "AdminPatrolSettings": {
    "RetentionDays": 90   // 巡檢報告保留天數（1～3650），每天 03:00 的「巡檢報告清理」刪除（系統參數頁可改）
  },

  // ── 紀錄保留天數 ──
