  "SlowOperationSettings": {
    "HttpRequestMs": 3000,   // 單一 HTTP 請求（系統參數頁可改）
    "DbCommandMs": 1000,   // 單一資料庫指令（只記指令類型，不記 SQL）（系統參數頁可改）
    "ExternalCallMs": 10000,   // 背景寄出一封信（系統參數頁可改）
