  "LogRetentionSettings": {
    "ExceptionLogDays": 90,   // 系統例外紀錄（連同堆疊檔）保留天數（0～36500，系統參數頁可改）
    "AuditLogDays": 365,   // 稽核紀錄的異動與安全事件保留天數；稽核是責任證據，有法規或內控要求請調大或設 0（系統參數頁可改）
    "AuditBrowsingLogDays": 90,   // 稽核紀錄的瀏覽類（換頁、搜尋、查看）保留天數；只有 AuditLogSettings:RecordBrowsing 開啟才會產生（系統參數頁可改）
    "TokenUsageLogDays": 365   // Token 用量紀錄（連同原始檔）保留天數（0～36500，系統參數頁可改）
  },

  // ── 稽核紀錄的記錄範圍 ──
