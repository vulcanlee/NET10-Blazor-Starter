      "SoftDeletePurge": { "Cron": "0 3 * * *" },   // 已刪除資料清理，每天 03:00
      "SystemBackup": { "Cron": "0 2 * * *" },   // 系統備份，每天 02:00（排在各項清理之前）
      "NotificationRetention": { "Cron": "0 3 * * *" },   // 站內通知清理，每天 03:00
      "EmailLogRetention": { "Cron": "0 3 * * *" },   // 寄信紀錄清理，每天 03:00
