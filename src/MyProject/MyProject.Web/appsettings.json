  "AuditLogSettings": {
    "RecordFieldChanges": false,   // 是否記錄修改前後差異（改了哪些欄位、舊值→新值；可能含個資）（系統參數頁可改）
    "RecordBrowsing": false   // 是否記錄換頁、搜尋、打開來看（含誰看過稽核紀錄）；筆數最多，是稽核資料變大的主因（系統參數頁可改）
  },

  // ── 已刪除資料的永久清除 ──
  "SoftDeleteSettings": {
    "PurgeAfterDays": 90   // 專案、分類、團隊、使用者、角色刪除超過幾天就永久刪除（0＝不自動刪），每天 03:00 執行（系統參數頁可改）
  },

  // ── 系統備份 ──
  // 備份位置在 ExternalFileSystem:BackupPath，執行時間在 ScheduledJobSettings:Jobs:SystemBackup（預設每天 02:00）。
  "BackupSettings": {
    "KeepCount": 7,   // 保留最新幾份備份（0～365，0＝不自動刪）；只在備份成功後才刪舊的（系統參數頁可改）
    "IncludeAiCallLogs": false,   // 是否一併備份 AI 對話紀錄內容檔（檔案大）（系統參數頁可改）
    "IncludeAiAgentConversations": false   // 是否一併備份 Agent 對話與巡檢報告內容檔；不備份時還原後對話無法接續（系統參數頁可改）
  },

