@page "/admin-assistant"
@layout MainLayout

<PageTitle>系統管理助理</PageTitle>

<AdminAssistantView InitialPatrolReportId="@PatrolReport" />

@code {
    /// <summary>定時巡檢通知（站內、Email）的連結帶過來的報告編號（0.9.161 起）；有值時自動打開「巡檢報告」並選那一份。</summary>
    [SupplyParameterFromQuery(Name = "patrolReport")]
    public Guid? PatrolReport { get; set; }
}
