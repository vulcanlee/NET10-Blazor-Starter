@page "/not-found"
@layout MainLayout
@inject ILogger<NotFound> Logger
@inject NavigationManager NavigationManager

<h3>Not Found</h3>
<p>Sorry, the content you are looking for does not exist.</p>

@code {
    protected override void OnInitialized()
    {
        // 404 先前只在 HTTP middleware 留下一筆，看不出是哪個使用者要去哪裡。
        Logger.LogWarning("Not-found page displayed. RequestedUri={RequestedUri}", NavigationManager.Uri);
    }
}
