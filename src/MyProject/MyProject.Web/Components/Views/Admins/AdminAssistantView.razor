@using MyProject.Business.Services.DataAccess
@using MyProject.Models.Systems
@using MyProject.Web.Ai
@using MyProject.Web.Ai.Agents
@using MyProject.Web.Ai.Agents.AdminAssistant

@*
    系統管理助理（0.9.155 起）：只限管理員的單一對話入口，每則訊息先自動分派領域，再由對應的專家回答。
    版面與互動沿用 Agent 測試台（AgentPlaygroundView）；差別是用每輪規劃器開對話，每則 AI 回覆標示「由誰回答」。
*@
@* 權限判定完成前不渲染任何內容，否則沒有權限的人會先看到頁面框架（PageAuthorizationTests 守門）。 *@
@if (!isAccessChecked)
{
}
else if (string.IsNullOrEmpty(RoleMessage) == false)
{
    <div class="alert alert-danger" role="alert">
        @RoleMessage
    </div>
}
else
{
    <div class="agent-playground-layout">
        <aside class="agent-playground-sidebar">
            <div class="agent-playground-sidebar-title">我的對話</div>
            @if (conversations.Count == 0)
            {
                <div class="agent-playground-empty">還沒有對話。送出第一則訊息後會出現在這裡。</div>
            }
            else
            {
                <ul class="agent-playground-list">
                    @foreach (var item in conversations)
                    {
                        var current = chat?.ConversationId == item.ConversationId;
                        <li class="@(current ? "agent-playground-list-item agent-playground-list-item-current" : "agent-playground-list-item")">
                            <button type="button"
                                    class="agent-playground-list-open"
                                    disabled="@(IsBusy || unavailableReason is not null)"
                                    title="@item.Title"
                                    @onclick="@(async () => await OnOpenConversationAsync(item))">
                                <span class="agent-playground-list-title">@item.Title</span>
                                <span class="agent-playground-list-meta">
                                    @item.UpdatedAt.ToString("yyyy/MM/dd HH:mm")
                                    @if (item.HasPendingApproval)
                                    {
                                        <span class="agent-playground-list-pending">待核准</span>
                                    }
                                </span>
                            </button>
                            <span class="agent-playground-list-actions">
                                <CrudActionButton Title="重新命名" Icon="edit" Disabled="@IsBusy"
                                                  OnClick="@(() => OnRename(item))" />
                                <CrudActionButton Title="刪除這段對話" Icon="delete" Danger Disabled="@IsBusy"
                                                  OnClick="@(async () => await OnDeleteAsync(item))" />
                            </span>
                        </li>
                    }
                </ul>
            }
        </aside>

        <div class="agent-playground">
            <div class="agent-playground-intro">
                <div class="agent-playground-intro-text">
                    <div class="agent-playground-title">@AdminAssistantAgent.DisplayName</div>
                    <div class="agent-playground-hint">
                        用一般說話的方式查詢系統狀況，助理會自動交給對應領域的專家回答；要修改資料時會先請你核准。
                        對話會自動保存在左側「我的對話」，只有你自己看得到；最後一次對話超過 @conversationService.RetentionDays 天會自動刪除。
                    </div>
                    @if (string.IsNullOrEmpty(modelName) == false)
                    {
                        <div class="agent-playground-hint">使用模型：@modelName</div>
                    }
                </div>
                <div class="agent-playground-actions">
                    <ToolbarIconButton Title="新對話" Icon="add_comment"
                                       Disabled="@(unavailableReason is not null || IsBusy)"
                                       OnClick="OnNewConversation" />
                </div>
            </div>

            @if (unavailableReason is not null)
            {
                <div class="alert alert-warning" role="alert">@unavailableReason</div>
            }
            else
            {
                <div class="agent-playground-conversation">
                    @if (Entries.Count == 0 && isRunning == false)
                    {
                        <div class="agent-playground-empty">試試看（點一下會填進輸入框）：</div>
                        <div class="admin-assistant-samples">
                            @foreach (var sample in SamplePrompts)
                            {
                                <button type="button" class="admin-assistant-sample" @onclick="@(() => inputText = sample)">@sample</button>
                            }
                        </div>
                    }

                    @foreach (var entry in Entries)
                    {
                        @switch (entry.Kind)
                        {
                            case AiAgentTranscriptKinds.User:
                                <div class="agent-playground-entry agent-playground-entry-user">@entry.Text</div>
                                break;
                            case AiAgentTranscriptKinds.Assistant:
                                @*
                                    AI 輸出受工具回傳的資料（日誌、例外、帳號資料可能含使用者輸入）影響，屬不可信輸入，
                                    一律經 AiMarkdownRenderer.ToSafeHtml 的安全管線之後才能用 MarkupString。
                                *@
                                var html = HtmlOf(entry);
                                @if (string.IsNullOrEmpty(entry.Agent) == false)
                                {
                                    <span class="admin-assistant-agent">由 @entry.Agent 回答</span>
                                }
                                @if (html is null)
                                {
                                    <div class="agent-playground-entry agent-playground-entry-error">AI 回傳內容異常龐大，已中止顯示。</div>
                                }
                                else
                                {
                                    <div class="agent-playground-entry agent-playground-entry-assistant">
                                        <div class="agent-playground-report">@((MarkupString)html)</div>
                                    </div>
                                }
                                break;
                            case AiAgentTranscriptKinds.Tool:
                                <div class="agent-playground-tool">🔧 @entry.Text</div>
                                break;
                            case AiAgentTranscriptKinds.Notice:
                                <div class="agent-playground-notice">@entry.Text</div>
                                break;
                            case AiAgentTranscriptKinds.Error:
                                <div class="agent-playground-entry agent-playground-entry-error">@entry.Text</div>
                                break;
                        }
                    }

                    @if (isRunning)
                    {
                        @if (streamingHtml.Length > 0)
                        {
                            <div class="agent-playground-entry agent-playground-entry-assistant">
                                <div class="agent-playground-report">@((MarkupString)streamingHtml)</div>
                            </div>
                        }

                        <div class="agent-playground-generating">
                            <Spin Size="@SpinSize.Small" />
                            <span>@RunningText…已 @elapsedSeconds 秒</span>
                            <Button Danger Size="@ButtonSize.Small" Icon="stop" OnClick="OnStop">停止產生</Button>
                        </div>
                    }
                </div>

                <div class="agent-playground-composer">
                    <TextArea @bind-Value="inputText"
                              Rows="3"
                              MaxLength="@MaxInputLength"
                              Disabled="@(IsBusy || IsAwaitingApproval)"
                              Placeholder="輸入問題或指示…" />
                    @* 「送出」刻意不看輸入框有沒有字（同 Agent 測試台）：TextArea 失焦才回寫值，空白內容由 OnSendAsync 忽略。 *@
                    <Button Type="@ButtonType.Primary"
                            Disabled="@(IsBusy || IsAwaitingApproval)"
                            OnClick="@(async () => await OnSendAsync())">送出</Button>
                </div>
            }
        </div>
    </div>

    @* 核准窗：會異動資料的工具執行前一定要經過這裡（不能點遮罩或 × 略過，必須選一個）。寬度沿用 Agent 測試台的全域樣式。 *@
    <Modal Title="系統管理助理要執行會修改資料的操作"
           Class="agent-playground-approval-modal"
           @bind-Visible="@approvalVisible"
           Closable="false"
           MaskClosable="false"
           Keyboard="false"
           Footer="null">
        <div class="agent-playground-approval">
            <p>請確認是否允許助理執行下列操作。核准後會以<strong>你的身分</strong>修改系統，並記錄在稽核紀錄。</p>
            @foreach (var approval in pendingApprovals)
            {
                <div class="agent-playground-approval-item">
                    <div class="agent-playground-approval-name">@approval.DisplayName</div>
                    <dl class="agent-playground-approval-args">
                        @foreach (var argument in approval.Arguments)
                        {
                            <div><dt>@argument.Key</dt><dd>@argument.Value</dd></div>
                        }
                    </dl>
                </div>
            }
            <div class="agent-playground-approval-actions">
                <Button OnClick="@(async () => await OnDecideAsync(approve: false))">拒絕</Button>
                <Button Type="@ButtonType.Primary" OnClick="@(async () => await OnDecideAsync(approve: true))">核准</Button>
            </div>
        </div>
    </Modal>

    @* 重新命名：只有一個欄位（標題只給本人看，改了不寫稽核）。寬度沿用 Agent 測試台的全域樣式。 *@
    <Modal Title="重新命名對話"
           Class="agent-playground-rename-modal"
           @bind-Visible="@renameVisible"
           MaskClosable="false"
           Keyboard="true"
           OkText="@("儲存")"
           CancelText="@("取消")"
           OnOk="@(async () => await OnRenameSaveAsync())">
        <Input @bind-Value="renameTitle" MaxLength="@AiAgentConversationService.MaxTitleLength" />
    </Modal>
}
