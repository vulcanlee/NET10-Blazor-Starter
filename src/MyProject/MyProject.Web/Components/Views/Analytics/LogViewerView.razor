@using MyProject.Web.Diagnostics

@if (string.IsNullOrEmpty(RoleMessage) == false)
{
    <div class="alert alert-danger" role="alert">
        @RoleMessage
    </div>
}
else
{
    <div>
        <div class="log-view-toolbar">
            <div class="log-view-toolbar-left">
                <DatePicker TValue="DateTime?" @bind-Value="startTime"
                            ShowTime="@true" Format="yyyy-MM-dd HH:mm:ss"
                            Placeholder="@("起始時間")" Style="width: 190px;" />
                <span class="log-view-range-separator">～</span>
                <DatePicker TValue="DateTime?" @bind-Value="endTime"
                            ShowTime="@true" Format="yyyy-MM-dd HH:mm:ss"
                            Placeholder="@("結束時間")" Style="width: 190px;" />

                <Select TItem="string" TItemValue="string" @bind-Value="minimumLevel"
                        Style="width: 118px;">
                    @foreach (var option in LevelOptions)
                    {
                        <SelectOption TItemValue="string" TItem="string" Value="@option.Key">@option.Label</SelectOption>
                    }
                </Select>

                <AntDesign.InputNumber TValue="int" @bind-Value="takeCount"
                                       Min="1" Max="@LogQueryRequest.MaxTake" Step="100"
                                       Style="width: 110px;" />

                <Input class="log-view-search-input" @bind-Value="keyword" Placeholder="關鍵字（比對整筆原始內容）" />
            </div>
            <div class="log-view-toolbar-right">
                <ToolbarIconButton Title="查詢" Icon="search"
                                   OnClick="@(async () => await OnQueryAsync())" />
                <ToolbarIconButton Title="匯出本次查詢結果（原始 nlog 格式）" Icon="file_download"
                                   Disabled="@(entriesAscending.Count == 0)"
                                   OnClick="@(async () => await OnExportAsync())" />
            </div>
        </div>

        @if (string.IsNullOrWhiteSpace(statusMessage) == false)
        {
            <div class="alert alert-info log-view-alert" role="alert">@statusMessage</div>
        }

        @foreach (var warning in warnings)
        {
            <div class="alert alert-warning log-view-alert" role="alert">@warning</div>
        }

        <div class="log-view-table-wrap">
            <Table TItem="LogEntry"
                   Class="log-view-table"
                   DataSource="@entriesDisplay"
                   Loading="@isLoading"
                   Size="TableSize.Small"
                   RowKey="@(entry => entry.Sequence)"
                   PageSize="20">
                <ColumnDefinitions>
                    <Column TData="DateTime" Title="時間" Width="180">
                        @context.Timestamp.ToString("yyyy-MM-dd HH:mm:ss.fff")
                    </Column>
                    <Column TData="string" Title="等級" Width="90">
                        <Tag Color="@GetLevelColor(context.Rank)">@(string.IsNullOrEmpty(context.Level) ? "－" : context.Level)</Tag>
                    </Column>
                    <Column TData="string" Title="記錄器" Width="260" Ellipsis>@context.Logger</Column>
                    <Column TData="string" Title="訊息" Ellipsis>@context.Message</Column>
                    <Column TData="string" Title="TraceId" Width="130" Ellipsis>@context.TraceId</Column>
                </ColumnDefinitions>
                <ExpandTemplate Context="rowData">
                    <pre class="log-view-raw">@rowData.Data.Raw</pre>
                </ExpandTemplate>
            </Table>
        </div>
    </div>
}
