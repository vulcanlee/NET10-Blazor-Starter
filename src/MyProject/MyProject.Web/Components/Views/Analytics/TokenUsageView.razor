@using MyProject.Models.Systems

@* 權限判定完成前不渲染任何內容，否則沒有權限的人會先看到頁面框架（PageAuthorizationTests 守門）。 *@
@if (!isAccessChecked)
{
}
else if (string.IsNullOrEmpty(RoleMessage) == false)
{
    <div class="alert alert-danger" role="alert">
        @RoleMessage
    </div>
}
else
{
    <div>
        <div class="token-usage-intro">
            <p>
                記錄每次呼叫大語言模型的 token 用量：是哪個<strong>作業</strong>、哪個 <strong>API 型別</strong>、
                哪個<strong>模型</strong>、哪個<strong>使用者</strong>，以及供應商回傳的各類 token 數。本頁僅管理員可見。
            </p>
            <p>
                輸入（送出／prompt）與輸出（接收／completion）計價不同；<strong>快取</strong>是輸入的折扣子集、
                <strong>推理</strong>計入輸出，兩者都只是「其中多少」，不另外加進合計。按每列「詳細」可看到完整分組與原始明細。
            </p>
            <p>
                失敗的呼叫也會記錄。其中<strong>回應成功但內容為空</strong>特別值得注意 ——
                上游照常計費，使用者卻什麼都沒拿到。依音訊時長計費、不回傳 token 數的模型不計入 token 合計。
            </p>
            <p>
                <strong>費用</strong>是呼叫當下依 <code>AiPricingSettings</code> 的單價與匯率算好、連同單價快照一起存下來的，
                <strong>事後調整設定不會改變已經記錄的帳</strong>。找不到該模型費率設定的呼叫標示為「未定價」，不計入合計；
                0.9.17 之前的紀錄沒有單價快照，一律未定價。合計的美金與台幣<strong>各自為逐列加總</strong>，
                區間橫跨匯率調整時兩者彼此推不出來。
            </p>
        </div>

        <div class="token-usage-toolbar">
            <div class="token-usage-toolbar-left">
                <Input class="token-usage-account-input" @bind-Value="accountFilter" Placeholder="帳號" />
                <DatePicker TValue="DateTime?" @bind-Value="startDate" Picker="@DatePickerType.Date"
                            Format="yyyy-MM-dd" Placeholder="@("起始日")" Style="width: 140px;" />
                <DatePicker TValue="DateTime?" @bind-Value="endDate" Picker="@DatePickerType.Date"
                            Format="yyyy-MM-dd" Placeholder="@("結束日")" Style="width: 140px;" />

                <Select TItem="string" TItemValue="string" @bind-Value="selectedOperation" Style="width: 150px;">
                    <SelectOption TItemValue="string" TItem="string" Value="@("")" Label="全部作業" />
                    @foreach (var item in filterOptions.Operations)
                    {
                        <SelectOption TItemValue="string" TItem="string" Value="@item" Label="@item" />
                    }
                </Select>

                <Select TItem="string" TItemValue="string" @bind-Value="selectedCallKind" Style="width: 130px;">
                    <SelectOption TItemValue="string" TItem="string" Value="@("")" Label="全部型別" />
                    @foreach (var item in filterOptions.CallKinds)
                    {
                        <SelectOption TItemValue="string" TItem="string" Value="@item" Label="@item" />
                    }
                </Select>

                <Select TItem="string" TItemValue="string" @bind-Value="selectedModel" Style="width: 170px;">
                    <SelectOption TItemValue="string" TItem="string" Value="@("")" Label="全部模型" />
                    @foreach (var item in filterOptions.Models)
                    {
                        <SelectOption TItemValue="string" TItem="string" Value="@item" Label="@item" />
                    }
                </Select>
            </div>
            <div class="token-usage-toolbar-right">
                <ToolbarIconButton Title="查詢" Icon="search"
                                   OnClick="@(async () => await OnSearchAsync())" />
                <ToolbarIconButton Title="重新整理" Icon="refresh"
                                   OnClick="@(async () => await OnRefreshAsync())" />
                <ToolbarIconButton Title="匯出目前查詢結果（CSV）" Icon="file_download"
                                   Disabled="@(summary.CallCount == 0)"
                                   OnClick="@(async () => await OnExportCsvAsync())" />
                <ToolbarIconButton Title="下載 PDF 報表" Icon="picture_as_pdf"
                                   Disabled="@(summary.CallCount == 0 || isExportingPdf)"
                                   OnClick="@(async () => await OnExportPdfAsync())" />
                <ToolbarIconButton Title="清空全部紀錄" Icon="delete_forever"
                                   OnClick="@(async () => await OnClearAllAsync())" />
            </div>
        </div>

        <div class="token-usage-purge">
            <DatePicker TValue="DateTime?" @bind-Value="purgeBeforeDate" Picker="@DatePickerType.Date"
                        Format="yyyy-MM-dd" Placeholder="@("清除此日之前")" Style="width: 160px;" />
            <Button Danger Disabled="@(purgeBeforeDate is null)"
                    OnClick="@(async () => await OnPurgeAsync())">批次清除</Button>
        </div>

        <div class="token-usage-summary">
            篩選範圍合計 —
            輸入(送出) <strong>@FormatCompact(summary.InputCount)</strong>、
            輸出(接收) <strong>@FormatCompact(summary.OutputCount)</strong>、
            其中快取 <strong>@FormatCompact(summary.CachedInputCount)</strong>、
            其中推理 <strong>@FormatCompact(summary.ReasoningCount)</strong>、
            合計 <strong>@FormatCompact(summary.TotalCount)</strong>、
            花費 <strong>NT$ @FormatCostTwdTotal(summary.CostTwd)</strong>
            （US$ @FormatCostUsdTotal(summary.CostUsd)）
            @if (summary.UnpricedCount > 0)
            {
                <span class="token-usage-unpriced">　⚠ 其中 @summary.UnpricedCount 筆未定價未計入</span>
            }
        </div>

        <Tabs @bind-ActiveKey="activeTabKey" OnTabClick="OnTabChangedAsync">
            <TabPane Key="@TabByAccount" Tab="@($"依使用者（{groupedByAccount.Count}）")">
                <TokenUsageGroupTable Rows="groupedByAccount" KeyTitle="使用者" />
            </TabPane>
            <TabPane Key="@TabByOperation" Tab="@($"依作業（{groupedByOperation.Count}）")">
                <TokenUsageGroupTable Rows="groupedByOperation" KeyTitle="作業" />
            </TabPane>
            <TabPane Key="@TabByModel" Tab="@($"依模型（{groupedByModel.Count}）")">
                <TokenUsageGroupTable Rows="groupedByModel" KeyTitle="模型" />
            </TabPane>
            <TabPane Key="@TabByCallKind" Tab="@($"依型別（{groupedByCallKind.Count}）")">
                <TokenUsageGroupTable Rows="groupedByCallKind" KeyTitle="型別" />
            </TabPane>
            <TabPane Key="@TabDetail" Tab="@($"明細（{_total}）")">
                <div class="token-usage-table-wrap">
                    <Table @ref="table"
                           TItem="TokenUsageLogAdapterModel"
                           RemoteDataSource="true"
                           DataSource="@rows"
                           Loading="@isLoading"
                           Size="TableSize.Small"
                           OnChange="OnTableChange"
                           @bind-PageIndex="_pageIndex"
                           @bind-PageSize="_pageSize"
                           @bind-Total="_total">
                        <Column TData="DateTime" DataIndex="@nameof(TokenUsageLogAdapterModel.OccurredAt)"
                                Title="時間" Width="160" Sortable DefaultSortOrder="SortDirection.Descending">
                            @context.OccurredAt.ToString("yyyy-MM-dd HH:mm:ss")
                        </Column>
                        <Column TData="string" Title="使用者" Width="110" Ellipsis>@(context.Account ?? "（系統自動）")</Column>
                        <Column TData="string" Title="作業" Width="140" Ellipsis>@context.Operation</Column>
                        <Column TData="string" Title="型別" Width="90">@context.CallKind</Column>
                        <Column TData="string" Title="模型" Width="150" Ellipsis>@context.Model</Column>
                        <Column TData="string" Title="輸入" Width="90" Align="ColumnAlign.Right">@FormatCell(context.InputCount)</Column>
                        <Column TData="string" Title="輸出" Width="90" Align="ColumnAlign.Right">@FormatCell(context.OutputCount)</Column>
                        <Column TData="string" Title="推理" Width="80" Align="ColumnAlign.Right">@FormatCell(context.ReasoningCount)</Column>
                        <Column TData="string" Title="快取" Width="80" Align="ColumnAlign.Right">@FormatCell(context.CachedInputCount)</Column>
                        <Column TData="string" Title="合計" Width="100" Align="ColumnAlign.Right">
                            @if (context.Success == false)
                            {
                                <Tooltip Title="@context.FailureReason">
                                    <Tag Color=@("red")>失敗</Tag>
                                </Tooltip>
                            }
                            else if (context.IsDurationBilled)
                            {
                                <span>時長 @context.DurationSeconds!.Value.ToString("N0") 秒</span>
                            }
                            else
                            {
                                <strong>@FormatCell(context.TotalCount)</strong>
                            }
                        </Column>
                        @*
                            ⚠️ 不要在這一欄加 Fixed="ColumnFixPlacement.Right"。
                            AntDesign 的 ColumnBase.CalcFixedStyle() 會去讀相鄰釘住欄的寬度，
                            而隔壁的 ActionColumn 沒有設 Width，會丟 ArgumentNullException 讓整頁掛掉。
                            要釘就得連 ActionColumn 的寬度一起定，不值得為此改動既有欄位 ——
                            這張表在加費用欄之前就已經橫向捲動（見 token-usage-table-wrap 的註解）。
                            不捲動也看得到的金額在上方合計橫幅與四張分組統計表。
                        *@
                        <Column TData="double?" DataIndex="@nameof(TokenUsageLogAdapterModel.CostTwd)"
                                Title="費用" Width="110" Align="ColumnAlign.Right" Sortable>
                            @if (context.IsUnpriced)
                            {
                                <Tooltip Title="@("找不到此模型的費率設定（appsettings.json 的 AiPricingSettings），因此不估算費用。")">
                                    <span class="token-usage-unpriced">未定價</span>
                                </Tooltip>
                            }
                            else
                            {
                                <Tooltip Title="@BuildCostTooltip(context)">
                                    <span>@FormatCostTwdCell(context.CostTwd)</span>
                                </Tooltip>
                            }
                        </Column>
                        <ActionColumn Title="操作" Fixed="ColumnFixPlacement.Right">
                            <Space>
                                <SpaceItem>
                                    <CrudActionButton Title="詳細" Icon="visibility"
                                                      OnClick="@(async () => await OnViewAsync(@context))" />
                                </SpaceItem>
                                <SpaceItem>
                                    <CrudActionButton Title="刪除" Icon="delete" Danger="true"
                                                      OnClick="@(async () => await OnDeleteAsync(@context))" />
                                </SpaceItem>
                            </Space>
                        </ActionColumn>
                    </Table>
                </div>
            </TabPane>
        </Tabs>

        @*
            明細窗：尺寸與內容樣式都寫在 Components/Commons/OverlayStyles.razor 的全域 style
            （AntDesign 的 Modal 渲染在元件 DOM 之外，scoped CSS 連 ::deep 都打不到）。
        *@
        <Modal Title="Token 用量明細"
               Class="token-usage-modal"
               @bind-Visible="@detailVisible"
               Keyboard="true"
               Footer="null"
               OnCancel="@(() => detailVisible = false)">
            @if (detailItem is not null)
            {
                <dl class="token-usage-detail-list">
                    <div><dt>時間</dt><dd>@detailItem.OccurredAt.ToString("yyyy-MM-dd HH:mm:ss")</dd></div>
                    <div><dt>使用者</dt><dd>@DetailAccountText</dd></div>
                    <div><dt>作業</dt><dd>@detailItem.Operation</dd></div>
                    <div><dt>型別</dt><dd>@detailItem.CallKind</dd></div>
                    <div><dt>供應商</dt><dd>@detailItem.Provider</dd></div>
                    <div><dt>模型</dt><dd>@detailItem.Model</dd></div>
                    <div><dt>耗時</dt><dd>@detailItem.ElapsedMilliseconds.ToString("N0") ms</dd></div>
                    <div>
                        <dt>結果</dt>
                        <dd>
                            @if (detailItem.Success)
                            {
                                <Tag Color=@("green")>成功</Tag>
                            }
                            else
                            {
                                <Tag Color=@("red")>失敗</Tag>
                                <span>@detailItem.FailureReason</span>
                            }
                        </dd>
                    </div>
                    <div><dt>紀錄 Id</dt><dd>@detailItem.Id</dd></div>
                </dl>

                <h3 class="token-usage-detail-title">輸入 (Input) — 送出／prompt，計價較低（快取更便宜）</h3>
                <dl class="token-usage-detail-list">
                    <div><dt>輸入合計（prompt）</dt><dd>@FormatCell(detailItem.InputCount)</dd></div>
                    <div><dt>快取命中（cached，輸入折扣）</dt><dd>@FormatCell(detailItem.CachedInputCount)</dd></div>
                    <div><dt>圖片輸入（含於上方，不另計）</dt><dd>@FormatCell(detailItem.ImageInputCount)</dd></div>
                    <div><dt>圖片輸入快取（含於上方，不另計）</dt><dd>@FormatCell(detailItem.ImageCachedInputCount)</dd></div>
                </dl>

                <h3 class="token-usage-detail-title">輸出 (Output) — 接收／completion，計價較高（含推理）</h3>
                <dl class="token-usage-detail-list">
                    <div><dt>輸出合計（completion）</dt><dd>@FormatCell(detailItem.OutputCount)</dd></div>
                    <div><dt>推理（reasoning，計入輸出）</dt><dd>@FormatCell(detailItem.ReasoningCount)</dd></div>
                    <div><dt>圖片輸出（含於上方，不另計）</dt><dd>@FormatCell(detailItem.ImageOutputCount)</dd></div>
                </dl>

                <h3 class="token-usage-detail-title">其他</h3>
                <dl class="token-usage-detail-list">
                    <div>
                        <dt>音訊時長（秒；依時長計費，未回傳 token）</dt>
                        <dd>@FormatCell(detailItem.DurationSeconds)</dd>
                    </div>
                    <div><dt>字元數（語音合成計費單位）</dt><dd>@FormatCell(detailItem.CharacterCount)</dd></div>
                    <div><dt>合計 (total)</dt><dd><strong>@FormatCell(detailItem.TotalCount)</strong></dd></div>
                </dl>

                <h3 class="token-usage-detail-title">費用 — 呼叫當下的快照，事後改設定不影響這一列</h3>
                @if (detailItem.IsUnpriced)
                {
                    <p class="token-usage-detail-empty">
                        未定價 —— 找不到模型「@detailItem.Model」的費率設定（appsettings.json 的 AiPricingSettings）。
                    </p>
                }
                else
                {
                    <dl class="token-usage-detail-list">
                        <div><dt>費用 (TWD)</dt><dd><strong>NT$ @FormatCostTwdCell(detailItem.CostTwd)</strong></dd></div>
                        <div><dt>費用 (USD)</dt><dd>US$ @FormatCostUsdCell(detailItem.CostUsd)</dd></div>
                        <div><dt>當時匯率</dt><dd>@FormatExchangeRate(detailItem.CostExchangeRate)</dd></div>
                        <div><dt>計價依據</dt><dd>@DetailPriceKeyText</dd></div>
                        <div><dt>長脈絡費率</dt><dd>@(detailItem.CostLongContext ? "是" : "否")</dd></div>
                    </dl>

                    @if (detailCostRateRows.Count > 0)
                    {
                        <dl class="token-usage-detail-list token-usage-raw-list">
                            @foreach (var item in detailCostRateRows)
                            {
                                <div><dt>套用費率 @item.Key</dt><dd>@item.Value</dd></div>
                            }
                        </dl>
                    }
                }

                <h3 class="token-usage-detail-title">原始明細（供應商回傳）</h3>
                @if (detailRawRows.Count == 0)
                {
                    <p class="token-usage-detail-empty">@detailRawMessage</p>
                }
                else
                {
                    <dl class="token-usage-detail-list token-usage-raw-list">
                        @foreach (var item in detailRawRows)
                        {
                            <div><dt>@item.Key</dt><dd>@item.Value</dd></div>
                        }
                    </dl>
                }
            }
        </Modal>
    </div>
}
