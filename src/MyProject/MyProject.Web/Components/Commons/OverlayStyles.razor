<style>

    /* ══════════════════════════════════════════════════════════════════
       AntDesign 浮層的全域樣式 —— 粉梅暖雪果凍
       規範全文見 docs/architecture/對話窗 UI 設計規範.md

       涵蓋：表單對話窗（.form-modal）、確認窗（.ant-modal-confirm）、
       右下角通知（.ant-notification-notice）、頂部消息條（.ant-message-notice-content）、
       以及尚未遷移的既有版型（唯讀明細窗、AI 分析窗）。

       ⚠️ 本元件只能在 Components/Routes.razor 渲染一次（AntContainer 旁邊）。
          AntDesign 把這些浮層全部渲染在 AntContainer 底下，與 layout 無關；
          掛在 layout 或各檢視裡，只要有頁面用了別的 layout 就會吃不到樣式。
          由 FormModalConventionTests 守門。
       ⚠️ AntDesign 的 CSS 在 App.razor 最後載入，覆蓋 .ant-* 一律要 !important。
       ⚠️ 尺寸不可改用 Modal 的 Width 參數（見速查表 §6.4）：兩邊都寫只會讓下一個人改錯地方。
          確認窗更是完全沒得選 —— ConfirmOptions.ClassName 會被 AntDesign 內部覆寫掉，
          個別確認窗無法掛自訂 class，只能吃這裡的全域 .ant-modal-confirm。
       ⚠️ 本檔是 .razor，CSS 裡的單一 at 符號一律要寫兩次（@@media / @@supports / @@keyframes）。
       ⚠️ scoped CSS 裡 :root 無效，CSS 變數掛在最外層容器 class 上（同 Login.razor.css 手法）。
       ══════════════════════════════════════════════════════════════════ */

    /* ── 中和 AntDesign 自己的進場動畫 ──
       AntD 把 antZoomIn 掛在 .ant-modal 上（.ant-zoom-enter 基底還有 transform: scale(0)），
       不關掉的話會與我們掛在 .ant-modal-content 上的果凍動畫疊加，
       實際彈跳幅度會比設計時選定的更誇張。離場動畫（antZoomOut）保留不動。 */
    .ant-modal.ant-zoom-enter,
    .ant-modal.ant-zoom-appear {
        animation: none !important;
        transform: none !important;
        opacity: 1 !important;
    }

    .form-modal {
        --fm-text: #51132f;
        --fm-muted: #704054;
        --fm-accent: #a52b59;
        --fm-accent-dim: #d37598;
        --fm-line: rgba(165, 43, 89, 0.18);
        --fm-error: #9a173a;
        width: 95vw !important;
        /* .ant-modal 預設 max-width: calc(100vw - 32px)，這裡必須壓過它 */
        max-width: 1400px !important;
        /* 上下各留 2.5vh，讓遮罩透出來，果凍與毛玻璃才看得出來 */
        top: 2.5vh !important;
        padding-bottom: 0 !important;
        margin: 0 auto !important;
    }

    /* 標題列與按鈕列固定、中間捲動 */
    .form-modal .ant-modal-content {
        height: 95vh !important;
        max-height: 95vh !important;
        display: flex !important;
        flex-direction: column !important;
        overflow: hidden !important;
        color: var(--fm-text) !important;
        /* 果凍本體：半透明 + 內外亮邊，手法沿用 Login.razor.css 的 .login-card */
        border: 3px solid rgba(255, 255, 255, 0.92) !important;
        border-radius: 34px !important;
        background: rgba(255, 237, 244, 0.95) !important;
        box-shadow: inset 0 3px 5px #fff, inset 0 -6px 14px rgba(232, 139, 169, 0.5),
                    0 0 0 6px rgba(255, 224, 236, 0.5), 0 28px 70px rgba(107, 39, 69, 0.26) !important;
        animation: fm-arrive 620ms cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    /* 毛玻璃只在瀏覽器支援時才降低不透明度，否則維持可讀的實底 */
    @@supports ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
        .form-modal .ant-modal-content {
            background: rgba(255, 234, 243, 0.62) !important;
            backdrop-filter: blur(26px) saturate(1.15);
            -webkit-backdrop-filter: blur(26px) saturate(1.15);
        }
    }

    /* 果凍進場：擠壓回彈（squash & stretch） */
    @@keyframes fm-arrive {
        0% { opacity: 0; transform: scale(0.72, 0.86); }
        45% { opacity: 1; transform: scale(1.035, 0.965); }
        70% { transform: scale(0.985, 1.018); }
        88% { transform: scale(1.006, 0.995); }
        100% { transform: scale(1, 1); }
    }

    /* 勾選回彈 */
    @@keyframes fm-jelly-check {
        50% { transform: scale(1.14); }
        100% { transform: scale(1); }
    }

    .form-modal .ant-modal-header {
        flex-shrink: 0;
        padding: 18px 28px !important;
        border-bottom: 1px solid var(--fm-line) !important;
        border-radius: 31px 31px 0 0 !important;
        /* 不透明底會把毛玻璃切掉一整條 */
        background: transparent !important;
    }

    .form-modal .ant-modal-title {
        color: var(--fm-text) !important;
        font-size: 1.15rem !important;
        font-weight: 800 !important;
    }

    .form-modal .ant-modal-close {
        color: var(--fm-muted) !important;
    }

    .form-modal .ant-modal-close:hover {
        color: var(--fm-accent) !important;
    }

    .form-modal .ant-modal-body {
        flex: 1 !important;
        /* 沒有這行，flex 子項不會縮，捲軸永遠不會出現 */
        min-height: 0 !important;
        overflow-y: auto !important;
        padding: 20px 28px !important;
        /* 捲軸出現時版面不要橫跳 */
        scrollbar-gutter: stable;
    }

    .form-modal .ant-modal-footer {
        flex-shrink: 0;
        padding: 14px 28px !important;
        border-top: 1px solid var(--fm-line) !important;
        border-radius: 0 0 31px 31px !important;
        background: transparent !important;
    }

    /* ── 區塊分組 ── */
    .form-modal .form-section {
        margin: 0 0 1.5rem;
    }

    .form-modal .form-section:last-child {
        margin-bottom: 0;
    }

    .form-modal .form-section-title {
        display: flex;
        align-items: baseline;
        gap: 0.6rem;
        margin: 0 0 0.9rem;
        padding-bottom: 0.4rem;
        border-bottom: 1px dashed var(--fm-line);
        color: var(--fm-accent);
        font-size: 0.95rem;
        font-weight: 800;
        letter-spacing: 0.02em;
    }

    .form-modal .form-section-hint {
        color: var(--fm-muted);
        font-size: 0.78rem;
        font-weight: 400;
    }

    /* ── 2 欄 grid ──
       AntD 的 FormItem 外層就是 .ant-form-item（單純的 block div），
       直接當 grid item，不需要再包一層，也不要用 AntD 的 Row/Col。 */
    .form-modal .form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0 1.75rem;
        /* 左右兩欄各自量高，長驗證訊息只撐高自己那一格 */
        align-items: start;
    }

    .form-modal .form-grid-single {
        grid-template-columns: minmax(0, 1fr);
    }

    .form-modal .form-grid > .ant-form-item {
        /* 不可省：grid item 預設 min-width:auto，多選 Select 的 tag 一多就會撐破欄寬 */
        min-width: 0;
        /* AntD 預設 24px，兩欄排列時太鬆 */
        margin-bottom: 1rem !important;
    }

    /* 不適合 2 欄的欄位（多行文字、檔案上傳、清單、權限矩陣…）獨占整行 */
    .form-modal .form-grid > .form-field-full {
        grid-column: 1 / -1;
    }

    .form-modal .form-field-hint {
        margin-top: 0.3rem;
        color: var(--fm-muted);
        font-size: 0.8rem;
        line-height: 1.5;
    }

    /* ── 驗證訊息（Blazor 的 ValidationMessage / ValidationSummary）── */
    .form-modal .validation-message {
        display: block;
        margin-top: 0.3rem;
        color: var(--fm-error);
        font-size: 0.82rem;
        line-height: 1.5;
        /* 長訊息換行，不要橫向撐破格子 */
        overflow-wrap: anywhere;
    }

    .form-modal .validation-errors {
        margin: 0 0 1rem;
        padding: 0.75rem 1rem 0.75rem 2rem;
        border-radius: 16px;
        background: rgba(255, 214, 229, 0.75);
        color: var(--fm-error);
        font-size: 0.85rem;
    }

    /* ── 果凍 Q 彈回饋 ── */
    .form-modal .ant-input,
    .form-modal .ant-input-affix-wrapper,
    .form-modal .ant-input-number,
    .form-modal .ant-picker,
    .form-modal .ant-select-selector {
        border-radius: 14px !important;
        background: rgba(255, 252, 254, 0.72) !important;
        transition: border-color 200ms ease, box-shadow 200ms ease, background-color 200ms ease;
    }

    .form-modal .ant-input:focus,
    .form-modal .ant-input-focused,
    .form-modal .ant-input-affix-wrapper-focused,
    .form-modal .ant-select-focused .ant-select-selector,
    .form-modal .ant-picker-focused,
    .form-modal .ant-input-number-focused {
        border-color: var(--fm-accent-dim) !important;
        background: rgba(255, 249, 252, 0.94) !important;
        box-shadow: 0 0 0 5px rgba(240, 146, 179, 0.2), inset 0 1px 2px #fff !important;
    }

    .form-modal .ant-form-item-label > label {
        color: var(--fm-text) !important;
        font-weight: 500;
    }

    .form-modal .ant-select-selection-item {
        border-radius: 999px !important;
    }

    .form-modal .ant-checkbox-checked .ant-checkbox-inner {
        background-color: var(--fm-accent) !important;
        border-color: var(--fm-accent) !important;
        animation: fm-jelly-check 220ms ease-out;
    }

    .form-modal .ant-modal-footer .ant-btn,
    .ant-modal-confirm .ant-modal-confirm-btns .ant-btn {
        border-radius: 999px !important;
        font-weight: 700;
        transition: transform 220ms cubic-bezier(0.2, 0.8, 0.3, 1.3), box-shadow 220ms ease;
    }

    .form-modal .ant-modal-footer .ant-btn-primary,
    .ant-modal-confirm .ant-modal-confirm-btns .ant-btn-primary {
        border-color: transparent !important;
        background: linear-gradient(165deg, #ea88ad 0%, #c43970 58%, #b52a60 100%) !important;
        text-shadow: 0 1px 2px rgba(93, 15, 48, 0.3);
        box-shadow: inset 0 3px 5px rgba(255, 255, 255, 0.6), 0 8px 20px rgba(173, 45, 93, 0.2) !important;
    }

    @@media (hover: hover) and (pointer: fine) {
        .form-modal .ant-modal-footer .ant-btn:hover,
        .ant-modal-confirm .ant-modal-confirm-btns .ant-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 26px rgba(173, 45, 93, 0.26) !important;
        }
    }

    .form-modal .ant-modal-footer .ant-btn:active,
    .ant-modal-confirm .ant-modal-confirm-btns .ant-btn:active {
        transform: scale(0.97);
    }

    /* ── 窄螢幕：塌成單欄 + 全螢幕 ── */
    @@media (max-width: 767.98px) {
        .form-modal {
            width: 100vw !important;
            max-width: 100vw !important;
            top: 0 !important;
            margin: 0 !important;
        }

        .form-modal .ant-modal-content {
            height: 100vh !important;
            /* 行動瀏覽器的動態網址列 */
            height: 100svh !important;
            max-height: none !important;
            border: 0 !important;
            border-radius: 0 !important;
        }

        .form-modal .ant-modal-header {
            border-radius: 0 !important;
            padding: 14px 16px !important;
        }

        .form-modal .ant-modal-body {
            padding: 16px !important;
        }

        .form-modal .ant-modal-footer {
            border-radius: 0 !important;
            padding: 12px 16px !important;
        }

        .form-modal .form-grid {
            grid-template-columns: minmax(0, 1fr);
            gap: 0;
        }
    }

    /* ── 無障礙降級：比照 Login.razor.css 的 prefers-reduced-motion 區段 ── */
    @@media (prefers-reduced-motion: reduce) {
        .form-modal .ant-modal-content,
        .form-modal .ant-checkbox-checked .ant-checkbox-inner {
            animation: none !important;
        }

        .form-modal .ant-input,
        .form-modal .ant-select-selector,
        .form-modal .ant-modal-footer .ant-btn {
            transition: none !important;
        }

        .form-modal .ant-modal-footer .ant-btn:hover,
        .form-modal .ant-modal-footer .ant-btn:active {
            transform: none !important;
        }
    }

    /* ══════════════════════════════════════════════════════════════════
       小型確認窗（ModalService.ConfirmAsync）—— 不滿版
       文案與參數一律由 Components/Commons/ConfirmDialog.cs 樣板決定。

       ⚠️ 這裡的選擇器只能是全域的 .ant-modal-confirm：
          AntDesign 的 Confirm 在內部把 ConfirmOptions.ClassName 無條件覆寫成
          "ant-modal-confirm ant-modal-confirm-" + ConfirmType，
          呼叫端給的 class 會被丟掉，所有確認窗只能一起變。
       ⚠️ 預設寬度 416px 是 AntDesign 寫在 .ant-modal 上的 inline style，覆寫必須 !important。
       ══════════════════════════════════════════════════════════════════ */

    .ant-modal-confirm {
        --cf-text: #51132f;
        --cf-muted: #704054;
        --cf-accent: #a52b59;
        --cf-edge: rgba(255, 255, 255, 0.92);
        --cf-glow: rgba(255, 224, 236, 0.45);
        --cf-inner: rgba(232, 139, 169, 0.42);
        --cf-tint: rgba(255, 237, 244, 0.96);
        --cf-tint-glass: rgba(255, 234, 243, 0.70);
        width: 440px !important;
        max-width: 90vw !important;
    }

    /* 破壞性確認（刪除／清空／放棄變更）轉紅調。
       ConfirmOptions.ClassName 既然無效，改以「確定鈕是 Danger」當 hook ——
       ConfirmDialog.AskDestructiveAsync 一律會設 OkButtonProps.Danger。
       :has() 不支援時只是退回粉梅（按鈕本身仍是紅的），屬漸進增強。 */
    .ant-modal-confirm:has(.ant-btn-dangerous) {
        --cf-accent: #b42318;
        --cf-glow: rgba(255, 214, 214, 0.5);
        --cf-inner: rgba(214, 120, 120, 0.4);
        --cf-tint: rgba(255, 238, 238, 0.96);
        --cf-tint-glass: rgba(255, 236, 236, 0.72);
    }

    .ant-modal-confirm .ant-modal-content {
        border: 2px solid var(--cf-edge) !important;
        border-radius: 24px !important;
        background: var(--cf-tint) !important;
        box-shadow: inset 0 2px 4px #fff, inset 0 -4px 10px var(--cf-inner),
                    0 0 0 4px var(--cf-glow), 0 20px 48px rgba(107, 39, 69, 0.24) !important;
        animation: cfm-arrive 380ms cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    @@supports ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
        .ant-modal-confirm .ant-modal-content {
            background: var(--cf-tint-glass) !important;
            backdrop-filter: blur(20px) saturate(1.15);
            -webkit-backdrop-filter: blur(20px) saturate(1.15);
        }
    }

    /* 短版果凍：380ms、起始縮放不像大表單窗那麼極端。
       確認窗出現頻率高（每刪一筆就跳一次），動作太大或太久都會變成干擾。 */
    @@keyframes cfm-arrive {
        0% { opacity: 0; transform: scale(0.86, 0.94); }
        50% { opacity: 1; transform: scale(1.02, 0.985); }
        78% { transform: scale(0.995, 1.006); }
        100% { transform: scale(1, 1); }
    }

    .ant-modal-confirm .ant-modal-body {
        padding: 24px 26px 18px !important;
    }

    .ant-modal-confirm-body .ant-modal-confirm-title {
        color: var(--cf-text) !important;
        font-weight: 700 !important;
    }

    .ant-modal-confirm-body .ant-modal-confirm-content {
        color: var(--cf-muted) !important;
        line-height: 1.6;
    }

    .ant-modal-confirm-body > .anticon {
        color: var(--cf-accent) !important;
    }

    /* ══════════════════════════════════════════════════════════════════
       右下角通知（NotificationService）與頂部消息條（MessageService）

       ⚠️ 圖示的語意色（成功綠／錯誤紅／警告橘／資訊藍）刻意**不動**：
          為了視覺統一把錯誤訊息染成粉紅，等於拿掉使用者最先讀到的那個訊號。
       ══════════════════════════════════════════════════════════════════ */

    .ant-notification-notice {
        border: 2px solid rgba(255, 255, 255, 0.9) !important;
        border-radius: 18px !important;
        background: rgba(255, 240, 246, 0.96) !important;
        box-shadow: inset 0 2px 3px #fff, inset 0 -3px 8px rgba(232, 139, 169, 0.32),
                    0 14px 34px rgba(107, 39, 69, 0.22) !important;
    }

    .ant-notification-notice-message {
        color: #51132f !important;
    }

    .ant-notification-notice-description {
        color: #704054 !important;
    }

    .ant-message-notice-content {
        border: 2px solid rgba(255, 255, 255, 0.92) !important;
        border-radius: 999px !important;
        background: rgba(255, 240, 246, 0.96) !important;
        color: #51132f !important;
        box-shadow: inset 0 2px 3px #fff, inset 0 -3px 7px rgba(232, 139, 169, 0.3),
                    0 10px 26px rgba(107, 39, 69, 0.2) !important;
        padding: 9px 20px !important;
    }

    @@supports ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
        .ant-notification-notice,
        .ant-message-notice-content {
            background: rgba(255, 238, 245, 0.80) !important;
            backdrop-filter: blur(14px) saturate(1.12);
            -webkit-backdrop-filter: blur(14px) saturate(1.12);
        }
    }

    /* 進場改成自家 keyframes：AntD 的 NotificationFadeIn 是用 left 位移，
       換成 transform 才能加上回彈，也不會干擾版面計算。離場維持 AntD 原本的。 */
    .ant-notification-fade-enter.ant-notification-fade-enter-active,
    .ant-notification-fade-appear.ant-notification-fade-appear-active {
        animation-name: notice-arrive !important;
        animation-duration: 420ms !important;
        animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1) !important;
    }

    @@keyframes notice-arrive {
        0% { opacity: 0; transform: translateX(36px) scale(0.96); }
        62% { opacity: 1; transform: translateX(-4px) scale(1.012); }
        100% { opacity: 1; transform: translateX(0) scale(1); }
    }

    .ant-message-notice {
        animation: msg-arrive 400ms cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    @@keyframes msg-arrive {
        0% { opacity: 0; transform: translateY(-18px) scale(0.94, 1.04); }
        58% { opacity: 1; transform: translateY(3px) scale(1.02, 0.98); }
        100% { opacity: 1; transform: translateY(0) scale(1, 1); }
    }

    /* 離場時不要讓進場動畫再跑一次（AntD 的 MessageMoveOut 掛在同一個元素上） */
    .ant-message-notice.ant-move-up-leave {
        animation-name: MessageMoveOut;
    }

    /* ── 小浮層的無障礙降級 ── */
    @@media (prefers-reduced-motion: reduce) {
        .ant-modal-confirm .ant-modal-content,
        .ant-message-notice,
        .ant-notification-fade-enter.ant-notification-fade-enter-active,
        .ant-notification-fade-appear.ant-notification-fade-appear-active {
            animation: none !important;
        }

        .ant-modal-confirm .ant-modal-confirm-btns .ant-btn {
            transition: none !important;
        }

        .ant-modal-confirm .ant-modal-confirm-btns .ant-btn:hover,
        .ant-modal-confirm .ant-modal-confirm-btns .ant-btn:active {
            transform: none !important;
        }
    }

    /* ══════════════════════════════════════════════════════════════════
       以下為尚未套用 .form-modal 的既有版型（唯讀明細窗、AI 分析窗等）
       ══════════════════════════════════════════════════════════════════ */

    /* form modals: 90% viewport size with scrollable body */
    .role-view-modal,
    .project-view-modal {
        width: 90vw !important;
        max-width: 90vw !important;
        top: 5vh !important;
        padding-bottom: 0 !important;
        margin: 0 auto !important;
    }

        .role-view-modal .ant-modal-content,
        .project-view-modal .ant-modal-content {
            height: 90vh !important;
            max-height: 90vh !important;
            display: flex !important;
            flex-direction: column !important;
            overflow: hidden !important;
        }

        .role-view-modal .ant-modal-header,
        .project-view-modal .ant-modal-header {
            flex-shrink: 0;
        }

        .role-view-modal .ant-modal-body,
        .project-view-modal .ant-modal-body {
            flex: 1 !important;
            min-height: 0 !important;
            overflow-y: auto !important;
        }

        .role-view-modal .ant-modal-footer,
        .project-view-modal .ant-modal-footer {
            flex-shrink: 0;
        }

    /* AI analysis modal: near full screen with scrollable body (long read-only report) */
    .log-ai-modal {
        width: 96vw !important;
        max-width: 96vw !important;
        top: 2vh !important;
        padding-bottom: 0 !important;
        margin: 0 auto !important;
    }

        .log-ai-modal .ant-modal-content {
            height: 96vh !important;
            max-height: 96vh !important;
            display: flex !important;
            flex-direction: column !important;
            overflow: hidden !important;
        }

        .log-ai-modal .ant-modal-header {
            flex-shrink: 0;
        }

        .log-ai-modal .ant-modal-body {
            flex: 1 !important;
            min-height: 0 !important;
