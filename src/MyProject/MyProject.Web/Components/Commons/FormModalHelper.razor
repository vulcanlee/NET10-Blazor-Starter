<style>

    /* ══════════════════════════════════════════════════════════════════
       表單型對話窗（大量資料輸入）—— 粉梅暖雪果凍版型
       規範全文見 docs/architecture/對話窗 UI 設計規範.md

       用法：Modal 標籤加上 Class="form-modal"。
       頁面若真的需要專屬微調，寫成 Class="form-modal xxx-modal" 並在本檔補 .xxx-modal 規則。

       ⚠️ AntDesign 的 CSS 在 App.razor 最後載入，覆蓋 .ant-modal-* 一律要 !important。
       ⚠️ 尺寸不可改用 Modal 的 Width 參數（見速查表 §6.4）：兩邊都寫只會讓下一個人改錯地方。
       ⚠️ 本檔是 .razor，CSS 裡的單一 at 符號一律要寫兩次（@@media / @@supports / @@keyframes）。
       ⚠️ scoped CSS 裡 :root 無效，CSS 變數掛在最外層容器 class 上（同 Login.razor.css 手法）。
       ══════════════════════════════════════════════════════════════════ */

    .form-modal {
        --fm-text: #51132f;
        --fm-muted: #704054;
        --fm-accent: #a52b59;
        --fm-accent-dim: #d37598;
        --fm-line: rgba(165, 43, 89, 0.18);
        --fm-error: #9a173a;
        width: 95vw !important;
        /* .ant-modal 預設 max-width: calc(100vw - 32px)，這裡必須壓過它 */
        max-width: 1400px !important;
        /* 上下各留 2.5vh，讓遮罩透出來，果凍與毛玻璃才看得出來 */
        top: 2.5vh !important;
        padding-bottom: 0 !important;
        margin: 0 auto !important;
    }

    /* 標題列與按鈕列固定、中間捲動 */
    .form-modal .ant-modal-content {
        height: 95vh !important;
        max-height: 95vh !important;
        display: flex !important;
        flex-direction: column !important;
        overflow: hidden !important;
        color: var(--fm-text) !important;
        /* 果凍本體：半透明 + 內外亮邊，手法沿用 Login.razor.css 的 .login-card */
        border: 3px solid rgba(255, 255, 255, 0.92) !important;
        border-radius: 34px !important;
        background: rgba(255, 237, 244, 0.95) !important;
        box-shadow: inset 0 3px 5px #fff, inset 0 -6px 14px rgba(232, 139, 169, 0.5),
                    0 0 0 6px rgba(255, 224, 236, 0.5), 0 28px 70px rgba(107, 39, 69, 0.26) !important;
        animation: fm-arrive 620ms cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    /* 毛玻璃只在瀏覽器支援時才降低不透明度，否則維持可讀的實底 */
    @@supports ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
        .form-modal .ant-modal-content {
            background: rgba(255, 234, 243, 0.62) !important;
            backdrop-filter: blur(26px) saturate(1.15);
            -webkit-backdrop-filter: blur(26px) saturate(1.15);
        }
    }

    /* 果凍進場：擠壓回彈（squash & stretch） */
    @@keyframes fm-arrive {
        0% { opacity: 0; transform: scale(0.72, 0.86); }
        45% { opacity: 1; transform: scale(1.035, 0.965); }
        70% { transform: scale(0.985, 1.018); }
        88% { transform: scale(1.006, 0.995); }
        100% { transform: scale(1, 1); }
    }

    /* 勾選回彈 */
    @@keyframes fm-jelly-check {
        50% { transform: scale(1.14); }
        100% { transform: scale(1); }
    }

    .form-modal .ant-modal-header {
        flex-shrink: 0;
        padding: 18px 28px !important;
        border-bottom: 1px solid var(--fm-line) !important;
        border-radius: 31px 31px 0 0 !important;
        /* 不透明底會把毛玻璃切掉一整條 */
        background: transparent !important;
    }

    .form-modal .ant-modal-title {
        color: var(--fm-text) !important;
        font-size: 1.15rem !important;
        font-weight: 800 !important;
    }

    .form-modal .ant-modal-close {
        color: var(--fm-muted) !important;
    }

    .form-modal .ant-modal-close:hover {
        color: var(--fm-accent) !important;
    }

    .form-modal .ant-modal-body {
        flex: 1 !important;
        /* 沒有這行，flex 子項不會縮，捲軸永遠不會出現 */
        min-height: 0 !important;
        overflow-y: auto !important;
        padding: 20px 28px !important;
        /* 捲軸出現時版面不要橫跳 */
        scrollbar-gutter: stable;
    }

    .form-modal .ant-modal-footer {
        flex-shrink: 0;
        padding: 14px 28px !important;
        border-top: 1px solid var(--fm-line) !important;
        border-radius: 0 0 31px 31px !important;
        background: transparent !important;
    }

    /* ── 區塊分組 ── */
    .form-modal .form-section {
        margin: 0 0 1.5rem;
    }

    .form-modal .form-section:last-child {
        margin-bottom: 0;
    }

    .form-modal .form-section-title {
        display: flex;
        align-items: baseline;
        gap: 0.6rem;
        margin: 0 0 0.9rem;
        padding-bottom: 0.4rem;
        border-bottom: 1px dashed var(--fm-line);
        color: var(--fm-accent);
        font-size: 0.95rem;
        font-weight: 800;
        letter-spacing: 0.02em;
    }

    .form-modal .form-section-hint {
        color: var(--fm-muted);
        font-size: 0.78rem;
        font-weight: 400;
    }

    /* ── 2 欄 grid ──
       AntD 的 FormItem 外層就是 .ant-form-item（單純的 block div），
       直接當 grid item，不需要再包一層，也不要用 AntD 的 Row/Col。 */
    .form-modal .form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0 1.75rem;
        /* 左右兩欄各自量高，長驗證訊息只撐高自己那一格 */
        align-items: start;
    }

    .form-modal .form-grid-single {
        grid-template-columns: minmax(0, 1fr);
    }

    .form-modal .form-grid > .ant-form-item {
        /* 不可省：grid item 預設 min-width:auto，多選 Select 的 tag 一多就會撐破欄寬 */
        min-width: 0;
        /* AntD 預設 24px，兩欄排列時太鬆 */
        margin-bottom: 1rem !important;
    }

    /* 不適合 2 欄的欄位（多行文字、檔案上傳、清單、權限矩陣…）獨占整行 */
    .form-modal .form-grid > .form-field-full {
        grid-column: 1 / -1;
    }

    .form-modal .form-field-hint {
        margin-top: 0.3rem;
        color: var(--fm-muted);
        font-size: 0.8rem;
        line-height: 1.5;
    }

    /* ── 驗證訊息（Blazor 的 ValidationMessage / ValidationSummary）── */
    .form-modal .validation-message {
        display: block;
        margin-top: 0.3rem;
        color: var(--fm-error);
        font-size: 0.82rem;
        line-height: 1.5;
        /* 長訊息換行，不要橫向撐破格子 */
        overflow-wrap: anywhere;
    }

    .form-modal .validation-errors {
        margin: 0 0 1rem;
        padding: 0.75rem 1rem 0.75rem 2rem;
        border-radius: 16px;
        background: rgba(255, 214, 229, 0.75);
        color: var(--fm-error);
        font-size: 0.85rem;
    }

    /* ── 果凍 Q 彈回饋 ── */
    .form-modal .ant-input,
    .form-modal .ant-input-affix-wrapper,
    .form-modal .ant-input-number,
    .form-modal .ant-picker,
    .form-modal .ant-select-selector {
        border-radius: 14px !important;
        background: rgba(255, 252, 254, 0.72) !important;
        transition: border-color 200ms ease, box-shadow 200ms ease, background-color 200ms ease;
    }

    .form-modal .ant-input:focus,
    .form-modal .ant-input-focused,
    .form-modal .ant-input-affix-wrapper-focused,
    .form-modal .ant-select-focused .ant-select-selector,
    .form-modal .ant-picker-focused,
    .form-modal .ant-input-number-focused {
        border-color: var(--fm-accent-dim) !important;
        background: rgba(255, 249, 252, 0.94) !important;
        box-shadow: 0 0 0 5px rgba(240, 146, 179, 0.2), inset 0 1px 2px #fff !important;
    }

    .form-modal .ant-form-item-label > label {
        color: var(--fm-text) !important;
        font-weight: 500;
    }

    .form-modal .ant-select-selection-item {
        border-radius: 999px !important;
    }

    .form-modal .ant-checkbox-checked .ant-checkbox-inner {
        background-color: var(--fm-accent) !important;
        border-color: var(--fm-accent) !important;
        animation: fm-jelly-check 220ms ease-out;
    }

    .form-modal .ant-modal-footer .ant-btn {
        border-radius: 999px !important;
        font-weight: 700;
        transition: transform 220ms cubic-bezier(0.2, 0.8, 0.3, 1.3), box-shadow 220ms ease;
    }

    .form-modal .ant-modal-footer .ant-btn-primary {
        border-color: transparent !important;
        background: linear-gradient(165deg, #ea88ad 0%, #c43970 58%, #b52a60 100%) !important;
        text-shadow: 0 1px 2px rgba(93, 15, 48, 0.3);
        box-shadow: inset 0 3px 5px rgba(255, 255, 255, 0.6), 0 8px 20px rgba(173, 45, 93, 0.2) !important;
    }

    @@media (hover: hover) and (pointer: fine) {
        .form-modal .ant-modal-footer .ant-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 26px rgba(173, 45, 93, 0.26) !important;
        }
    }

    .form-modal .ant-modal-footer .ant-btn:active {
        transform: scale(0.97);
    }

    /* ── 窄螢幕：塌成單欄 + 全螢幕 ── */
    @@media (max-width: 767.98px) {
        .form-modal {
            width: 100vw !important;
            max-width: 100vw !important;
            top: 0 !important;
            margin: 0 !important;
        }

        .form-modal .ant-modal-content {
            height: 100vh !important;
            /* 行動瀏覽器的動態網址列 */
            height: 100svh !important;
            max-height: none !important;
            border: 0 !important;
            border-radius: 0 !important;
        }

        .form-modal .ant-modal-header {
            border-radius: 0 !important;
            padding: 14px 16px !important;
        }

        .form-modal .ant-modal-body {
            padding: 16px !important;
        }

        .form-modal .ant-modal-footer {
            border-radius: 0 !important;
            padding: 12px 16px !important;
        }

        .form-modal .form-grid {
            grid-template-columns: minmax(0, 1fr);
            gap: 0;
        }
    }

    /* ── 無障礙降級：比照 Login.razor.css 的 prefers-reduced-motion 區段 ── */
    @@media (prefers-reduced-motion: reduce) {
        .form-modal .ant-modal-content,
        .form-modal .ant-checkbox-checked .ant-checkbox-inner {
            animation: none !important;
        }

        .form-modal .ant-input,
        .form-modal .ant-select-selector,
        .form-modal .ant-modal-footer .ant-btn {
            transition: none !important;
        }

        .form-modal .ant-modal-footer .ant-btn:hover,
        .form-modal .ant-modal-footer .ant-btn:active {
            transform: none !important;
        }
    }

    /* ══════════════════════════════════════════════════════════════════
       以下為尚未套用 .form-modal 的既有版型（唯讀明細窗、AI 分析窗等）
       ══════════════════════════════════════════════════════════════════ */

    /* form modals: 90% viewport size with scrollable body */
    .role-view-modal,
    .project-view-modal {
        width: 90vw !important;
        max-width: 90vw !important;
        top: 5vh !important;
        padding-bottom: 0 !important;
        margin: 0 auto !important;
    }

        .role-view-modal .ant-modal-content,
        .project-view-modal .ant-modal-content {
            height: 90vh !important;
            max-height: 90vh !important;
            display: flex !important;
            flex-direction: column !important;
            overflow: hidden !important;
        }

        .role-view-modal .ant-modal-header,
        .project-view-modal .ant-modal-header {
            flex-shrink: 0;
        }

        .role-view-modal .ant-modal-body,
        .project-view-modal .ant-modal-body {
            flex: 1 !important;
            min-height: 0 !important;
            overflow-y: auto !important;
        }

        .role-view-modal .ant-modal-footer,
        .project-view-modal .ant-modal-footer {
            flex-shrink: 0;
        }

    /* AI analysis modal: near full screen with scrollable body (long read-only report) */
    .log-ai-modal {
        width: 96vw !important;
        max-width: 96vw !important;
        top: 2vh !important;
        padding-bottom: 0 !important;
        margin: 0 auto !important;
    }

        .log-ai-modal .ant-modal-content {
            height: 96vh !important;
            max-height: 96vh !important;
            display: flex !important;
            flex-direction: column !important;
            overflow: hidden !important;
        }

        .log-ai-modal .ant-modal-header {
            flex-shrink: 0;
        }

        .log-ai-modal .ant-modal-body {
            flex: 1 !important;
            min-height: 0 !important;
            overflow-y: auto !important;
        }

    /* exception log detail modal: large read-only view (long stack traces need internal scrolling) */
    .exception-log-modal {
        width: 90vw !important;
        max-width: 90vw !important;
        top: 5vh !important;
        padding-bottom: 0 !important;
        margin: 0 auto !important;
    }

        .exception-log-modal .ant-modal-content {
            height: 90vh !important;
            max-height: 90vh !important;
            display: flex !important;
            flex-direction: column !important;
            overflow: hidden !important;
        }

        .exception-log-modal .ant-modal-header {
            flex-shrink: 0;
        }

        .exception-log-modal .ant-modal-body {
            flex: 1 !important;
            min-height: 0 !important;
            overflow-y: auto !important;
        }

    /*
       明細窗的「內容」樣式必須寫在這裡（全域），不能放 ExceptionLogView.razor.css ——
       AntDesign 的 Modal 會把內容渲染到元件 DOM 範圍之外的容器，
       scoped CSS（連 ::deep）都打不到，樣式會整組失效。
    */
    .exception-log-modal .exception-log-detail-list {
        display: grid;
        gap: 0.5rem;
        margin: 0 0 1.25rem;
    }

    .exception-log-modal .exception-log-detail-list > div {
        display: grid;
        gap: 0.25rem 1rem;
        grid-template-columns: 11rem 1fr;
    }

    .exception-log-modal .exception-log-detail-list dt {
        color: #64748b;
        font-size: 0.85rem;
        font-weight: 600;
    }

    .exception-log-modal .exception-log-detail-list dd {
        color: #0f172a;
        font-size: 0.9rem;
        margin: 0;
        word-break: break-word;
    }

    .exception-log-modal .exception-log-detail-title {
        color: #0f172a;
        font-size: 0.95rem;
        font-weight: 700;
        margin: 0 0 0.5rem;
    }

    .exception-log-modal .exception-log-stack {
        background: #0f172a;
        border-radius: 8px;
        color: #e2e8f0;
        font-size: 0.8rem;
        line-height: 1.6;
        margin: 0;
        padding: 0.9rem 1rem;
        white-space: pre-wrap;
        word-break: break-word;
    }

    @@media (max-width: 640.98px) {
        /* 窄螢幕沒有 11rem 可以留給標題，改成上下堆疊 */
        .exception-log-modal .exception-log-detail-list > div {
            grid-template-columns: 1fr;
        }
    }

    /* token usage detail modal: large read-only view */
    .token-usage-modal {
        width: 90vw !important;
        max-width: 90vw !important;
        top: 5vh !important;
        padding-bottom: 0 !important;
        margin: 0 auto !important;
    }

        .token-usage-modal .ant-modal-content {
            height: 90vh !important;
            max-height: 90vh !important;
            display: flex !important;
            flex-direction: column !important;
            overflow: hidden !important;
        }

        .token-usage-modal .ant-modal-header {
            flex-shrink: 0;
        }

        .token-usage-modal .ant-modal-body {
            flex: 1 !important;
            min-height: 0 !important;
            overflow-y: auto !important;
        }

    /* 同 .exception-log-modal：內容樣式必須寫在這裡（全域），
       AntDesign 的 Modal 會渲染到元件 DOM 範圍之外，scoped CSS 打不到。 */
    .token-usage-modal .token-usage-detail-list {
        display: grid;
        gap: 0.35rem;
        margin: 0 0 1rem;
    }

    .token-usage-modal .token-usage-detail-list > div {
        border-bottom: 1px solid #f1f5f9;
        display: grid;
        gap: 0.25rem 1rem;
        grid-template-columns: 18rem 1fr;
        padding-bottom: 0.3rem;
    }

    .token-usage-modal .token-usage-detail-list dt {
        color: #64748b;
        font-size: 0.85rem;
    }

    .token-usage-modal .token-usage-detail-list dd {
        color: #0f172a;
        font-size: 0.9rem;
        margin: 0;
        word-break: break-word;
    }

    .token-usage-modal .token-usage-raw-list dt {
        color: #b4222a;
        font-family: Consolas, "Courier New", monospace;
        font-size: 0.82rem;
    }

    .token-usage-modal .token-usage-detail-title {
        border-top: 2px solid #e2e8f0;
        color: #0f172a;
        font-size: 1rem;
        font-weight: 700;
        margin: 1.25rem 0 0.6rem;
        padding-top: 0.75rem;
    }

    .token-usage-modal .token-usage-detail-empty {
        color: #64748b;
        font-size: 0.88rem;
    }

    @@media (max-width: 640.98px) {
        .token-usage-modal .token-usage-detail-list > div {
            grid-template-columns: 1fr;
        }
    }

    /* change password modal: compact, auto height */
    .change-password-modal {
        width: 480px !important;
        max-width: 90vw !important;
        top: 20vh !important;
        padding-bottom: 0 !important;
        margin: 0 auto !important;
    }

    /* about modal: compact, auto height。
       尺寸寫在這裡而不是 Modal 的 Width 參數，見速查表 §6.4。 */
    .about-modal {
        width: 520px !important;
        max-width: 90vw !important;
        top: 15vh !important;
        padding-bottom: 0 !important;
        margin: 0 auto !important;
    }

    .role-view-table-wrap .ant-table-tbody > tr.ant-table-row:hover > td {
        background-color: #e6f4ff !important;
    }

    .role-view-table-wrap .ant-table-tbody > tr.ant-table-row:nth-child(odd) > td {
        background-color: #ffffff;
    }

    .role-view-table-wrap .ant-table-tbody > tr.ant-table-row:nth-child(even) > td {
        background-color: #f8fafc;
    }

    .role-view-table-wrap .ant-table-tbody > tr.ant-table-row:hover,
    .role-view-table-wrap .ant-table-tbody > tr.ant-table-row:hover > td {
        /*cursor: pointer;*/
    }

</style>
