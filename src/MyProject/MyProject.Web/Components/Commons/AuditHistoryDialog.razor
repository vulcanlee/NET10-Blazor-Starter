@using MyProject.Models.AdapterModel
@using MyProject.Web.Components.Views.Admins

@*
    某一筆資料的「異動歷程」（0.9.173 起）：五個資料頁與 CRUD 產生的頁面共用，一頁放一個，由 AuditHistoryButton 叫出。
    左邊是這一筆的異動（新增、修改、啟停用、刪除、還原……，不含換頁、搜尋、查看），右邊是點選那一筆的摘要與詳細內容。
    尺寸寫在 OverlayStyles.razor 的 .audit-history-modal（Modal 外框渲染在元件 DOM 之外，見速查 §6.4）；
    窗內內容的樣式在本元件的 .razor.css。純唯讀、不含 EditForm，Esc 直接關閉（§6.3）。
*@
<Modal Title="@($"異動歷程：{label}")"
       Class="audit-history-modal"
       @bind-Visible="@visible"
       Keyboard="true"
       Footer="null">
    <div class="audit-history-body">
        <div class="audit-history-hint">
            這一筆資料（@targetType #@targetId）在稽核紀錄裡的異動，新的在上面；時間為伺服器本地時間。
            稽核紀錄保留期限之前的異動已被清除。要看誰開過、查過這一筆，請到「稽核紀錄」頁查詢。
        </div>
        @if (isLoading)
        {
            <div class="audit-history-empty"><Spin Tip="讀取中…" /></div>
        }
        else if (items.Count == 0)
        {
            <div class="audit-history-empty">這一筆資料在稽核紀錄的保留期間內沒有異動紀錄。</div>
        }
        else
        {
            <div class="audit-history-layout">
                <div class="audit-history-list-pane">
                    <ul class="audit-history-list">
                        @foreach (var item in items)
                        {
                            var current = item.Id == selected?.Id;
                            <li>
                                <button type="button"
                                        class="@(current ? "audit-history-item audit-history-item-current" : "audit-history-item")"
                                        @onclick="@(async () => await SelectAsync(item))">
                                    <span class="audit-history-item-title">
                                        @item.OccurredAt.ToString("yyyy-MM-dd HH:mm:ss")
                                        <Tag Color="@AuditLogView.GetActionColor(item.ActionCategory)">@item.Action</Tag>
                                        @if (item.Success == false)
                                        {
                                            <Tag Color="@("red")">失敗</Tag>
                                        }
                                    </span>
                                    <span class="audit-history-item-meta">@AuditLogView.ActorText(item)</span>
                                </button>
                            </li>
                        }
                    </ul>
                    @if (total > PageSize)
                    {
                        <Pagination Class="audit-history-pager" Size="PaginationSize.Small"
                                    Current="@pageIndex" PageSize="@PageSize" Total="@total"
                                    OnChange="@(async (PaginationEventArgs e) => await ChangePageAsync(e.Page))" />
                    }
                </div>
                <div class="audit-history-detail">
                    @if (selected is null)
                    {
                        <div class="audit-history-empty">請從左側選一筆，查看摘要與修改前後差異。</div>
                    }
                    else
                    {
                        <dl class="audit-history-detail-list">
                            <div><dt>發生時間</dt><dd>@selected.OccurredAt.ToString("yyyy-MM-dd HH:mm:ss")</dd></div>
                            <div><dt>動作代碼</dt><dd>@selected.Action</dd></div>
                            <div><dt>結果</dt><dd>@(selected.Success ? "成功" : "失敗")</dd></div>
                            <div><dt>操作者</dt><dd>@AuditLogView.ActorText(selected)</dd></div>
                            <div><dt>來源 IP</dt><dd>@(selected.ClientIp ?? "—")</dd></div>
                        </dl>
                        <h3 class="audit-history-detail-title">摘要</h3>
                        <pre class="audit-history-detail-text">@(string.IsNullOrWhiteSpace(selected.Detail) ? "（無）" : selected.Detail)</pre>
                        <h3 class="audit-history-detail-title">詳細內容</h3>
                        <pre class="audit-history-detail-text">@ContentText</pre>
                    }
                </div>
            </div>
        }
    </div>
</Modal>
