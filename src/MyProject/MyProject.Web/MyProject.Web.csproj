<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <UserSecretsId>83f6d54f-9f33-4cd9-a626-d4c05c996e5d</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
    <PackageReference Include="Cronos" />
    <PackageReference Include="MailKit" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" />
    <PackageReference Include="Microsoft.Agents.AI.Workflows" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="OpenAI" />
    <PackageReference Include="QRCoder" />
    <PackageReference Include="ClosedXML" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
    <PackageReference Include="NLog.Web.AspNetCore" />
    <PackageReference Include="PDFsharp-MigraDoc" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyProject.Business\MyProject.Business.csproj" />
    <!--
      WASM 前端（0.10.0 起）。0.10.10 起前端是獨立的靜態站台；這個參考讓同站台部署（ClientSettings:BaseUrl 留空）時
      主機的發佈輸出帶著前端的靜態檔（wwwroot），由 UseFrontend 提供。見 docs/migration/WASM遷移計畫.md。
    -->
    <ProjectReference Include="..\MyProject.Web.Client\MyProject.Web.Client.csproj" />
  </ItemGroup>

  <!--
    同站台發佈時，前端靜態檔由這個專案（根專案）壓縮，只看這裡的設定：匯入前端的同一份「不產生壓縮副本」清單
    （Service Worker 兩個檔案、appsettings.json、manifest，0.10.11 起），否則 MapStaticAssets 會優先送出內容不對的 .br。
  -->
  <Import Project="..\MyProject.Web.Client\FrontendCompression.props" />

  <!--
    PDF 報告的中文字型。用 EmbeddedResource 而非 CopyToOutputDirectory：publish、
    單檔發行與容器化都不會漏檔，測試專案也能直接由組件讀取。LogicalName 明寫，
    避免 MSBuild 依資料夾與檔名中的「-」推導出意外的資源名稱。
    來源、產生方式與「為何只有 Regular」見 Fonts\README.md。
  -->
  <ItemGroup>
    <EmbeddedResource Include="Fonts\NotoSansTC-Regular.ttf" LogicalName="MyProject.Web.Fonts.NotoSansTC-Regular.ttf" />
  </ItemGroup>

  <!--
    頁面使用說明（Datas/Help/*.md，由 Datas/HelpTopics.json 索引）。
    Web SDK 預設只複製 *.json，.md 必須明寫；漏了不會編譯失敗，只會在 publish 後
    讓每一頁的說明都變成佔位內容。由 PageHelpCatalogTests 守門。
  -->
  <ItemGroup>
    <Content Include="Datas\Help\**\*.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!--
    同站台發佈（0.10.10 起）：前端的 index.html 要用處理過佔位的版本（import map、帶指紋的 blazor.webassembly 檔名）。
    SDK 從參考的 MyProject.Web.Client 帶進來的是原始檔（import map 空白、檔名還是佔位，瀏覽器載不到 WebAssembly），
    所以 Web 發佈後另外發佈一次 Client 到中繼資料夾，拿它的 index.html 覆蓋過去。兩邊是同一份建置結果，檔名指紋相同；
    覆蓋後逐一確認 index.html 引用的 _framework 檔案都在 Web 的發佈輸出裡，對不上就讓發佈失敗。
  -->
  <UsingTask TaskName="VerifyFrontendIndexHtml" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <WebRoot ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var html = File.ReadAllText(Path.Combine(WebRoot, "index.html"));
        // 檢查 src／href 與 import map 對應到的檔案（import map 左邊的未加指紋名稱不是實體檔）。
        var references = Regex.Matches(html, @"(?:(?:src|href)=""|:\s*""\./)(?<file>_framework/[^""]+)""").Cast<Match>().Select(x => x.Groups["file"].Value).Distinct().ToList();
        if (references.Count == 0 || html.Contains("{fingerprint}"))
        {
          Log.LogError("發佈輸出的 index.html 沒有處理過佔位（import map 或帶指紋的檔名）：" + Path.Combine(WebRoot, "index.html"));
          return false;
        }

        foreach (var reference in references.Where(x => !File.Exists(Path.Combine(WebRoot, x))))
        {
          Log.LogError("index.html 引用的 " + reference + " 不在發佈輸出裡（前端檔名指紋對不上）。");
        }
]]></Code>
    </Task>
  </UsingTask>

  <Target Name="UseProcessedFrontendIndexHtml" AfterTargets="Publish">
    <PropertyGroup>
      <_FrontendPublishDir>$(MSBuildProjectDirectory)\$(IntermediateOutputPath)frontend-publish\</_FrontendPublishDir>
    </PropertyGroup>
    <!-- RemoveProperties：外層的 -r／發行設定檔等不能傳給前端（0.10.10 獨立審查：-r win-x64 會讓前端發佈失敗）。 -->
    <MSBuild Projects="..\MyProject.Web.Client\MyProject.Web.Client.csproj" Targets="Publish" Properties="Configuration=$(Configuration);PublishDir=$(_FrontendPublishDir)"
             RemoveProperties="RuntimeIdentifier;SelfContained;PublishProfile;PublishReadyToRun;PublishSingleFile;PublishTrimmed;_TargetId;StaticSiteApiOrigin" />
    <Copy SourceFiles="$(_FrontendPublishDir)wwwroot\index.html" DestinationFiles="$(PublishDir)wwwroot\index.html" />
    <VerifyFrontendIndexHtml WebRoot="$(PublishDir)wwwroot" />
  </Target>

  <!-- 慣例守門測試需要讀取 SidebarMenuService.MenuPermissionMap 等宣告式登錄表。 -->
  <ItemGroup>
    <InternalsVisibleTo Include="MyProject.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Datas\" />
  </ItemGroup>

</Project>
