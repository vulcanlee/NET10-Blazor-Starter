@using MyProject.Web.Client.Commons
@implements IDisposable
@inject NavigationManager NavigationManager
@inject ClientErrorCapture ErrorCapture

@*
    WASM 頁面的根元件（0.10.1 起，WASM 遷移 M2；0.10.9 起是唯一的根元件；0.10.10 起由 Program.cs 掛在 index.html 的 #app）。
    只認得本組件的頁面（ClientRouteTable）；導向其他網址時改成整頁載入，交給網站處理（同站台時主機的 Swagger 等；其他網址主機或靜態站都回 index.html，再由這裡顯示找不到頁面）。
*@
<ConfigProvider>
    <Router AppAssembly="typeof(ClientRoutes).Assembly" OnNavigateAsync="OnNavigateAsync">
        <Found Context="routeData">
            @*
                最後防線：版面本身（或不用 ClientMainLayout 的頁面，例如登入頁）出錯時接住。
                用 ClientMainLayout 的頁面另有內容區的錯誤邊界（0.10.36 起），出錯時側邊選單仍在。換頁時兩者都會復原。
            *@
            <ClientErrorBoundary @ref="pageBoundary">
                <ChildContent>
                    <RouteView RouteData="routeData" DefaultLayout="typeof(ClientMainLayout)" />
                    <FocusOnNavigate RouteData="routeData" Selector="h1" />
                </ChildContent>
                <ErrorContent Context="exception">
                    <ClientPageErrorAlert Exception="exception" />
                </ErrorContent>
            </ClientErrorBoundary>
        </Found>
        @*
            找不到路由（0.10.8 起 /not-found 在 WASM）：0.10.10 起不是頁面的網址一律拿到 index.html（主機或靜態站的 SPA 回退），
            瀏覽器網址還是原本那個，這裡顯示與 /not-found 頁相同的內容與外框。
        *@
        <NotFound>
            <LayoutView Layout="typeof(ClientMainLayout)">
                <NotFoundContent />
            </LayoutView>
        </NotFound>
    </Router>

    @*
        AntDesign 的對話窗、確認窗、通知與消息條全部渲染在 AntContainer 底下，與 layout 無關，全域樣式也掛在這一層。
        ⚠️ OverlayStyles 全專案只能在這裡渲染一次；AntContainer 包在錯誤邊界裡，浮層內的未處理例外不會讓整個畫面停擺。
        兩者由 FormModalConventionTests 守門。
    *@
    <OverlayStyles />

    <ClientErrorBoundary @ref="overlayBoundary">
        <ChildContent>
            <AntContainer />
        </ChildContent>
        <ErrorContent Context="exception">
            <div class="alert alert-danger overlay-error-banner" role="alert">
                <strong>畫面元件發生錯誤，已記錄。</strong>
                請<a href="" @onclick="ReloadPage" @onclick:preventDefault>重新整理頁面</a>；若持續發生請聯絡系統管理員。
            </div>
        </ErrorContent>
    </ClientErrorBoundary>

    @*
        PWA 的狀態提示列（0.10.11 起，WASM 遷移 M12）：離線、有新版本。放在根元件，登入頁等匿名頁也看得到；
        固定在畫面底部置中（ClientRoutes.razor.css），不推擠版面。
    *@
    <div class="app-status-bars">
        <ClientOfflineBar />
        <ClientUpdateBar />
    </div>
</ConfigProvider>

@code {
    private ClientErrorBoundary? overlayBoundary;
    private ClientErrorBoundary? pageBoundary;
    private bool isInitialNavigation = true;

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
        // 操作軌跡的第一筆（0.10.36 起）：這次載入的頁面；登入頁等匿名頁也記，登入前的錯誤才看得出發生在哪一步。
        ErrorCapture.Navigated(new Uri(NavigationManager.Uri).AbsolutePath);
    }

    /// <summary>
    /// 不是 WASM 頁面的網址（例如同站台時連到 Swagger）：整頁載入目前的網址，交給網站。
    /// ⚠️ 用 NavigationManager.Uri（本站的完整網址），不從路徑重組（避免 //evil.com 被當成別的網站）；
    /// 剛整頁載入的第一次導覽不再重載 —— 主機判定是 WASM 頁面、這裡卻不認得時，重載只會無限迴圈，改顯示找不到頁面。
    /// </summary>
    private void OnNavigateAsync(NavigationContext context)
    {
        var isInitial = isInitialNavigation;
        isInitialNavigation = false;
        if (!isInitial && !ClientRouteTable.IsClientRoute(context.Path))
        {
            NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        ErrorCapture.Navigated(new Uri(e.Location).AbsolutePath);
        _ = InvokeAsync(() =>
        {
            overlayBoundary?.Recover();
            pageBoundary?.Recover();
        });
    }

    private void ReloadPage() => NavigationManager.Refresh(forceReload: true);

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
