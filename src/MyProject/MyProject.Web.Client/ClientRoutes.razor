@using MyProject.Web.Client.Commons
@implements IDisposable
@inject NavigationManager NavigationManager

@*
    WASM 頁面的根元件（0.10.1 起，WASM 遷移 M2；0.10.9 起是唯一的根元件，Server 版的 Routes.razor 已刪除）。
    只認得本組件的頁面（ClientRouteTable）；導向其他網址時改成整頁載入，交給主機處理（API、Swagger，或找不到時的 404）。
*@
<ConfigProvider>
    <Router AppAssembly="typeof(ClientRoutes).Assembly" OnNavigateAsync="OnNavigateAsync">
        <Found Context="routeData">
            <ClientErrorBoundary>
                <ChildContent>
                    <RouteView RouteData="routeData" DefaultLayout="typeof(ClientMainLayout)" />
                    <FocusOnNavigate RouteData="routeData" Selector="h1" />
                </ChildContent>
                <ErrorContent Context="exception">
                    <div class="alert alert-danger" role="alert">
                        <strong>這個頁面發生未預期的錯誤。</strong>
                        錯誤已記錄，請重新整理頁面；若持續發生請聯絡系統管理員。
                    </div>
                </ErrorContent>
            </ClientErrorBoundary>
        </Found>
        @*
            找不到路由（0.10.8 起 /not-found 在 WASM）：主機把 404 重跑成 /not-found 時，瀏覽器網址還是原本那個，
            這裡顯示與 /not-found 頁相同的內容與外框。
        *@
        <NotFound>
            <LayoutView Layout="typeof(ClientMainLayout)">
                <NotFoundContent />
            </LayoutView>
        </NotFound>
    </Router>

    @*
        AntDesign 的對話窗、確認窗、通知與消息條全部渲染在 AntContainer 底下，與 layout 無關，全域樣式也掛在這一層。
        ⚠️ OverlayStyles 全專案只能在這裡渲染一次；AntContainer 包在錯誤邊界裡，浮層內的未處理例外不會讓整個畫面停擺。
        兩者由 FormModalConventionTests 守門。
    *@
    <OverlayStyles />

    <ClientErrorBoundary @ref="overlayBoundary">
        <ChildContent>
            <AntContainer />
        </ChildContent>
        <ErrorContent Context="exception">
            <div class="alert alert-danger overlay-error-banner" role="alert">
                <strong>畫面元件發生錯誤，已記錄。</strong>
                請<a href="" @onclick="ReloadPage" @onclick:preventDefault>重新整理頁面</a>；若持續發生請聯絡系統管理員。
            </div>
        </ErrorContent>
    </ClientErrorBoundary>
</ConfigProvider>

@code {
    private ClientErrorBoundary? overlayBoundary;
    private bool isInitialNavigation = true;

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    /// <summary>
    /// 不是 WASM 頁面的網址（例如連到 Swagger 或 API）：整頁載入目前的網址，交給主機。
    /// ⚠️ 用 NavigationManager.Uri（本站的完整網址），不從路徑重組（避免 //evil.com 被當成別的網站）；
    /// 剛整頁載入的第一次導覽不再重載 —— 主機判定是 WASM 頁面、這裡卻不認得時，重載只會無限迴圈，改顯示找不到頁面。
    /// </summary>
    private void OnNavigateAsync(NavigationContext context)
    {
        var isInitial = isInitialNavigation;
        isInitialNavigation = false;
        if (!isInitial && !ClientRouteTable.IsClientRoute(context.Path))
        {
            NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _ = InvokeAsync(() => overlayBoundary?.Recover());
    }

    private void ReloadPage() => NavigationManager.Refresh(forceReload: true);

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
