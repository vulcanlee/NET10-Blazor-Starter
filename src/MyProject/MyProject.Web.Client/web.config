<?xml version="1.0" encoding="utf-8"?>
<!--
  前端靜態站台的 IIS 設定（0.10.10 起，WASM 遷移 M11；雙站台部署用，例如 https://app.公司.com/）。
  dotnet publish 的輸出：這份 web.config 在輸出根目錄，網站檔案（index.html、appsettings.json、_framework…）在 wwwroot\ 底下；
  IIS 站台的實體路徑指向輸出根目錄，下面的規則把網址對到 wwwroot\。需要 IIS 的 URL Rewrite 模組。
  同站台部署（API 主機一併提供前端）用不到這份檔案：API 主機的 UseFrontend 做同樣的事，安全標頭與 CSP 相同（StaticSiteWebConfigTests 守門）。

  ⚠️ 雙站台要設定的地方：
    1. 發佈時帶 API 主機的來源（只要 scheme＋主機＋連接埠）：
         dotnet publish src/MyProject/MyProject.Web.Client -c Release -o <輸出> -p:StaticSiteApiOrigin=https://api.公司.com
       會同時填入 wwwroot\appsettings.json 的 ApiBaseUrl 與下面 Content-Security-Policy 的 connect-src（兩處一致，重新發佈也照樣填好）。
       沒填的話 ApiBaseUrl 是空白（呼叫自己的網址）、connect-src 只有 'self'，瀏覽器會擋下所有 API 呼叫（主控台出現 CSP 錯誤）。
       ⚠️ 不要只改輸出裡的這兩處：下次發佈會被蓋回去；而且 0.10.11 起手改 wwwroot\ 底下任何檔案（含 appsettings.json）都會讓它與
       Service Worker 資產清單（service-worker-assets.js）上的完整性雜湊對不上，新版安裝失敗、使用者繼續用舊版（瀏覽器錯誤回報會記進 API 主機的日誌）。
       要改就重新發佈。
    2. API 主機的 ClientSettings:BaseUrl 填這個站台的網址（CORS、Google 登入導回、信中連結都靠它）。
  script-src 的 sha256 是 index.html 裡 import map 的雜湊，發佈時由 MyProject.Web.Client.csproj 自動填入（每次建置的檔名指紋不同），不要手改。

  規則：
    - 預先壓縮：瀏覽器接受 br、且有 .br 副本時送 .br（outbound 規則補上 Content-Encoding 與原本的 Content-Type）。
      IIS 自己的靜態壓縮關掉，避免已壓縮的回應再被壓一次。appsettings.json、Service Worker 兩個檔案與 manifest 刻意不產生壓縮副本
      （見 FrontendCompression.props：壓縮副本的內容不是發佈最後的版本）。
    - 實體檔案：wwwroot 底下有這個檔案就直接送。
    - _framework 底下找不到的檔案回 404（不回 index.html，否則瀏覽器會把 HTML 當成 .wasm／.js 解析，錯誤訊息完全看不懂）。
    - SPA 回退：其他網址一律回 index.html，由前端路由決定顯示哪一頁（找不到時顯示找不到頁面）。
    - 快取：預設 Cache-Control: no-cache（瀏覽器每次都向伺服器確認）；_framework 底下檔名帶指紋的檔案內容永遠不變，可以快取一年。
      PWA（0.10.11 起）：畫面的檔案（index.html、appsettings.json、_framework…）由 Service Worker 從自己的快取送，部署新版後不會立刻生效 ——
      瀏覽器檢查到 service-worker.js 變了（開頁或分頁回到前景時）才在背景安裝新版，等使用者按「有新版本」提示列才換上。
      service-worker.js、service-worker-assets.js、manifest.webmanifest 檔名不帶指紋，沿用預設的 no-cache，部署新版後才查得到。
    - 安全標頭：與 API 主機相同（X-Content-Type-Options、X-Frame-Options、Referrer-Policy、Strict-Transport-Security）；
      /Auths/ResetPassword 的網址帶 Token：Referrer-Policy: no-referrer、Cache-Control: no-store。
-->
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".wasm" />
      <remove fileExtension=".dll" />
      <remove fileExtension=".webcil" />
      <remove fileExtension=".dat" />
      <remove fileExtension=".blat" />
      <remove fileExtension=".pdb" />
      <remove fileExtension=".json" />
      <remove fileExtension=".woff" />
      <remove fileExtension=".woff2" />
      <remove fileExtension=".br" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".wasm" mimeType="application/wasm" />
      <mimeMap fileExtension=".dll" mimeType="application/octet-stream" />
      <mimeMap fileExtension=".webcil" mimeType="application/octet-stream" />
      <mimeMap fileExtension=".dat" mimeType="application/octet-stream" />
      <mimeMap fileExtension=".blat" mimeType="application/octet-stream" />
      <mimeMap fileExtension=".pdb" mimeType="application/octet-stream" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <!-- PWA 的 manifest（0.10.11 起）：IIS 預設不認得，會回 404。不產生 .br 副本（csproj 的 CompressionExcludePatterns）。 -->
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <!-- 預先壓縮的 .br 副本先以這個記號類型送出，outbound 規則再換成原本的類型並加上 Content-Encoding: br。 -->
      <mimeMap fileExtension=".br" mimeType="application/x-precompressed-brotli" />
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>
    <urlCompression doStaticCompression="false" doDynamicCompression="false" />
    <!-- 核心模式快取不認得依 Accept-Encoding 改寫的回應，關掉以免 .br 版本送給不支援的瀏覽器。 -->
    <caching enableKernelCache="false" />
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <!-- HSTS（0.10.10 獨立審查）：Token 存在前端網址的 storage，前端更需要只走 https；與 API 主機的 UseHsts 相同（30 天）。瀏覽器只在 https 回應採用。 -->
        <add name="Strict-Transport-Security" value="max-age=2592000" />
        <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'sha256-__IMPORTMAP_SHA256__'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'" />
      </customHeaders>
    </httpProtocol>
    <rewrite>
      <rules>
        <clear />
        <rule name="預先壓縮的 Brotli 檔" stopProcessing="true">
          <match url="^(.+)$" />
          <conditions logicalGrouping="MatchAll">
            <add input="{HTTP_ACCEPT_ENCODING}" pattern="\bbr\b" />
            <add input="{APPL_PHYSICAL_PATH}wwwroot\{R:1}.br" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="wwwroot/{R:1}.br" />
        </rule>
        <rule name="wwwroot 底下的實體檔案" stopProcessing="true">
          <match url="^(.+)$" />
          <conditions logicalGrouping="MatchAll">
            <add input="{APPL_PHYSICAL_PATH}wwwroot\{R:1}" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="wwwroot/{R:1}" />
        </rule>
        <rule name="_framework 找不到的檔案回 404" stopProcessing="true">
          <match url="^_framework/" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="The requested file was not found." />
        </rule>
        <rule name="SPA 回退到 index.html" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="wwwroot/index.html" />
        </rule>
      </rules>
      <outboundRules rewriteBeforeCache="true">
        <clear />
        <rule name="Brotli：Content-Encoding" preCondition="是預先壓縮的檔案">
          <match serverVariable="RESPONSE_Content_Encoding" pattern=".*" />
          <action type="Rewrite" value="br" />
        </rule>
        <rule name="Brotli：Vary" preCondition="是預先壓縮的檔案">
          <match serverVariable="RESPONSE_Vary" pattern=".*" />
          <action type="Rewrite" value="Accept-Encoding" />
        </rule>
        <rule name="Brotli：wasm 類型" preCondition="壓縮的 wasm">
          <match serverVariable="RESPONSE_Content_Type" pattern=".*" />
          <action type="Rewrite" value="application/wasm" />
        </rule>
        <rule name="Brotli：js 類型" preCondition="壓縮的 js">
          <match serverVariable="RESPONSE_Content_Type" pattern=".*" />
          <action type="Rewrite" value="text/javascript" />
        </rule>
        <rule name="Brotli：css 類型" preCondition="壓縮的 css">
          <match serverVariable="RESPONSE_Content_Type" pattern=".*" />
          <action type="Rewrite" value="text/css" />
        </rule>
        <rule name="Brotli：json 類型" preCondition="壓縮的 json">
          <match serverVariable="RESPONSE_Content_Type" pattern=".*" />
          <action type="Rewrite" value="application/json" />
        </rule>
        <rule name="Brotli：html 類型" preCondition="壓縮的 html">
          <match serverVariable="RESPONSE_Content_Type" pattern=".*" />
          <action type="Rewrite" value="text/html" />
        </rule>
        <rule name="Brotli：其他二進位類型" preCondition="壓縮的二進位檔">
          <match serverVariable="RESPONSE_Content_Type" pattern=".*" />
          <action type="Rewrite" value="application/octet-stream" />
        </rule>
        <rule name="帶指紋的檔案長期快取" preCondition="帶指紋的 _framework 檔案">
          <match serverVariable="RESPONSE_Cache_Control" pattern=".*" />
          <action type="Rewrite" value="public, max-age=31536000, immutable" />
        </rule>
        <rule name="重設密碼頁不快取" preCondition="重設密碼頁">
          <match serverVariable="RESPONSE_Cache_Control" pattern=".*" />
          <action type="Rewrite" value="no-store" />
        </rule>
        <rule name="重設密碼頁不送 Referer" preCondition="重設密碼頁">
          <match serverVariable="RESPONSE_Referrer_Policy" pattern=".*" />
          <action type="Rewrite" value="no-referrer" />
        </rule>
        <rule name="Referrer-Policy" preCondition="不是重設密碼頁">
          <match serverVariable="RESPONSE_Referrer_Policy" pattern=".*" />
          <action type="Rewrite" value="strict-origin-when-cross-origin" />
        </rule>
        <preConditions>
          <preCondition name="是預先壓縮的檔案">
            <add input="{RESPONSE_CONTENT_TYPE}" pattern="^application/x-precompressed-brotli" />
          </preCondition>
          <preCondition name="壓縮的 wasm" logicalGrouping="MatchAll">
            <add input="{RESPONSE_CONTENT_TYPE}" pattern="^application/x-precompressed-brotli" />
            <add input="{REQUEST_URI}" pattern="\.wasm(\?|$)" />
          </preCondition>
          <preCondition name="壓縮的 js" logicalGrouping="MatchAll">
            <add input="{RESPONSE_CONTENT_TYPE}" pattern="^application/x-precompressed-brotli" />
            <add input="{REQUEST_URI}" pattern="\.m?js(\?|$)" />
          </preCondition>
          <preCondition name="壓縮的 css" logicalGrouping="MatchAll">
            <add input="{RESPONSE_CONTENT_TYPE}" pattern="^application/x-precompressed-brotli" />
            <add input="{REQUEST_URI}" pattern="\.css(\?|$)" />
          </preCondition>
          <preCondition name="壓縮的 json" logicalGrouping="MatchAll">
            <add input="{RESPONSE_CONTENT_TYPE}" pattern="^application/x-precompressed-brotli" />
            <add input="{REQUEST_URI}" pattern="\.json(\?|$)" />
          </preCondition>
          <preCondition name="壓縮的 html" logicalGrouping="MatchAll">
            <add input="{RESPONSE_CONTENT_TYPE}" pattern="^application/x-precompressed-brotli" />
            <add input="{REQUEST_URI}" pattern="\.html?(\?|$)" />
          </preCondition>
          <preCondition name="壓縮的二進位檔" logicalGrouping="MatchAll">
            <add input="{RESPONSE_CONTENT_TYPE}" pattern="^application/x-precompressed-brotli" />
            <add input="{REQUEST_URI}" pattern="\.(dat|blat|dll|webcil|pdb)(\?|$)" />
          </preCondition>
          <!-- 只有 200 才長期快取（0.10.10 獨立審查）：部署途中新的 index.html 先上線、檔案還沒複製完時，404 不能被快取一年。 -->
          <preCondition name="帶指紋的 _framework 檔案" logicalGrouping="MatchAll">
            <add input="{REQUEST_URI}" pattern="^/_framework/[^?]*\.[a-z0-9]{10}\.(js|wasm|dat|blat|dll|webcil|pdb)(\?|$)" ignoreCase="false" />
            <add input="{RESPONSE_STATUS}" pattern="^200$" />
          </preCondition>
          <preCondition name="重設密碼頁">
            <add input="{REQUEST_URI}" pattern="^/Auths/ResetPassword(/|\?|$)" />
          </preCondition>
          <preCondition name="不是重設密碼頁">
            <add input="{REQUEST_URI}" pattern="^/Auths/ResetPassword(/|\?|$)" negate="true" />
          </preCondition>
        </preConditions>
      </outboundRules>
    </rewrite>
  </system.webServer>
</configuration>
