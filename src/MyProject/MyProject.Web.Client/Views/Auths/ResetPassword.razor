@page "/Auths/ResetPassword"
@layout ClientNoFooterLayout
@attribute [AllowAnonymous]

<PageTitle>重設密碼</PageTitle>

@if (settings is not null && isChecked)
{
    <AuthShell Title="重設密碼" Subtitle="@Subtitle" SystemName="@settings.SystemName" SystemDescription="@settings.SystemDescription">
        @if (!settings.EmailEnabled)
        {
            <div class="error-message" role="alert">
                系統目前未啟用寄信功能，無法自助重設密碼。請聯絡系統管理員協助。
            </div>
        }
        else if (!isTokenValid)
        {
            <div class="error-message" role="alert">
                @InvalidLinkMessage
            </div>
        }
        else
        {
            <EditForm Model="@Input" OnValidSubmit="SubmitAsync">
                <div class="form-group">
                    <label class="form-label" for="newPassword">新密碼</label>
                    <input id="newPassword" name="Input.NewPassword" type="password" class="form-input"
                           placeholder="請輸入新密碼" @bind="Input.NewPassword" autocomplete="new-password" />
                </div>

                <div class="form-group">
                    <label class="form-label" for="confirmPassword">確認新密碼</label>
                    <input id="confirmPassword" name="Input.ConfirmPassword" type="password" class="form-input"
                           placeholder="再輸入一次新密碼" @bind="Input.ConfirmPassword" autocomplete="new-password" />
                </div>

                <div class="login-actions">
                    <button class="login-button" type="submit" disabled="@isBusy">
                        設定新密碼
                    </button>
                </div>

                @if (!string.IsNullOrEmpty(message))
                {
                    <div class="error-message" role="alert">
                        @message
                    </div>
                }
            </EditForm>
        }

        <div class="auth-links">
            @if (settings.EmailEnabled && !isTokenValid)
            {
                <a class="auth-link" href="/Auths/ForgotPassword">重新申請重設信</a>
            }
            <a class="auth-link" href="/Auths/Login">返回登入</a>
        </div>
    </AuthShell>
}
