@page "/Auths/TwoFactor"
@layout ClientNoFooterLayout
@attribute [AllowAnonymous]

<PageTitle>兩步驟驗證</PageTitle>

@if (settings is not null && pending is not null)
{
    <AuthShell Title="兩步驟驗證" Subtitle="請輸入驗證器 App 上目前顯示的 6 位數驗證碼；手機不在身邊時，可以改輸入一組備用碼。"
               SystemName="@settings.SystemName" SystemDescription="@settings.SystemDescription">
        <EditForm Model="@Input" OnValidSubmit="SubmitAsync">
            <div class="form-group">
                <label class="form-label" for="code">驗證碼或備用碼</label>
                <input id="code" name="Input.Code" class="form-input" placeholder="例如 123456 或 ABCDE-FGH23"
                       @bind="Input.Code" autocomplete="one-time-code" inputmode="text" autofocus />
            </div>

            @if (pending.RememberDeviceDays > 0)
            {
                <div class="form-options">
                    <label class="remember-me">
                        <InputCheckbox id="rememberDevice" name="Input.RememberDevice" @bind-Value="Input.RememberDevice" />
                        <span>記住這台裝置 @pending.RememberDeviceDays 天</span>
                    </label>
                </div>
            }

            <div class="login-actions">
                <button class="login-button" type="submit" disabled="@isBusy">驗證並登入</button>
            </div>

            @if (!string.IsNullOrEmpty(message))
            {
                <div class="alert-danger error-message" role="alert">@message</div>
            }
        </EditForm>

        <div class="auth-links">
            <a class="auth-link" href="/Auths/Login">取消，回到登入頁</a>
        </div>
    </AuthShell>
}
else
{
    @* 讀取設定期間（0.10.13 起）：顯示載入卡片，不留白（接續下載期間的那一張）。 *@
    <ClientLoadingScreen Message="正在載入…" />
}
