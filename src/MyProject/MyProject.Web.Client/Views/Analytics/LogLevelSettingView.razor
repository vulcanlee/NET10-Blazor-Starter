@using MyProject.Web.Diagnostics

@* 權限判定完成前不渲染任何內容，否則沒有權限的人會先看到頁面框架（PageAuthorizationTests 守門）。 *@
@if (!isAccessChecked)
{
}
else if (string.IsNullOrEmpty(RoleMessage) == false)
{
    <div class="alert alert-danger" role="alert">
        @RoleMessage
    </div>
}
else if (isAvailable == false)
{
    <div class="alert alert-danger" role="alert">
        無法讀取 NLog 設定，日誌等級無法在執行期調整。請檢查 nlog.config 是否存在且含有
        <code>&lt;logger name="*"&gt;</code> 規則。
    </div>
}
else
{
    <div class="log-level-page">
        <div class="log-level-cards">
            <article class="log-level-card">
                <span class="log-level-card-label">目前生效等級</span>
                <strong class="log-level-card-value">@LogLevelRankHelper.ToLevelText(effectiveLevel)</strong>
                <span class="log-level-card-caption">此等級以上的日誌才會寫入檔案</span>
            </article>

            <article class="log-level-card">
                <span class="log-level-card-label">系統預設等級</span>
                <strong class="log-level-card-value">@LogLevelRankHelper.ToLevelText(systemDefaultLevel)</strong>
                <span class="log-level-card-caption">
                    來自 nlog.config 的 <code>&lt;logger name="*"&gt;</code> minlevel
                </span>
            </article>
        </div>

        <div class="alert alert-warning log-level-banner" role="alert">
            <p>
                <strong>這個設定只在執行期有效。</strong>
                系統重新啟動之後會回到上面的「系統預設等級」，不會寫進任何設定檔。
            </p>
            <p>
                套用之後即使 <code>nlog.config</code> 被重新載入，這個設定仍會保留 ——
                要回到檔案裡的值請按「還原為系統預設等級」。
            </p>
            <p>
                本設定<strong>只影響應用程式日誌</strong>；框架日誌（Microsoft、EntityFrameworkCore）
                另由 nlog.config 的專屬規則控制，不受這裡影響。
            </p>
            <p>
                <strong>調到 Debug 或 Trace 會大幅增加日誌量</strong>，排查完問題請記得調回來。
            </p>
        </div>

        <div class="log-level-choices">
            <p class="log-level-choices-title">選擇要輸出的最低等級</p>
            <RadioGroup TValue="LogLevelRank" @bind-Value="selectedLevel">
                @foreach (var option in LevelOptions)
                {
                    <div class="log-level-choice">
                        <Radio TValue="LogLevelRank" Value="@option.Level">
                            @LogLevelRankHelper.ToLevelText(option.Level)
                            <span class="log-level-choice-description">（@option.Description）</span>
                        </Radio>
                    </div>
                }
            </RadioGroup>
        </div>

        <div class="log-level-actions">
            <ToolbarIconButton Title="套用" Icon="check"
                               Disabled="@(selectedLevel == effectiveLevel)"
                               OnClick="@(async () => await OnApplyAsync())" />
            <ToolbarIconButton Title="還原為系統預設等級" Icon="history"
                               Disabled="@(hasOverride == false)"
                               OnClick="@(async () => await OnRestoreAsync())" />
        </div>

        @*
            前端診斷記錄（0.10.37 起）：對某位使用者開啟，他的瀏覽器在時限內把前端日誌送到伺服器的日誌檔。
            與上面的等級各自獨立（前端的日誌另有規則，不受上面的等級影響）；只在執行期有效，到期自動關閉。
        *@
        <section class="client-diagnostics" aria-labelledby="client-diagnostics-title">
            <h2 id="client-diagnostics-title" class="client-diagnostics-title">前端診斷記錄</h2>
            <p class="client-diagnostics-help">
                某位使用者回報的問題在伺服器日誌看不出原因時，可以對他開啟：這段時間內他瀏覽器裡的前端日誌（DEBUG 或 TRACE 以上）會送到伺服器，
                寫進日誌檔（「日誌檢視」的 Logger 是 <code>MyProject.Browser.*</code>）。對方畫面底部會看到「系統管理員已開啟診斷記錄」；
                最慢約 1 分鐘後開始送。只在執行期有效，到期自動關閉。
            </p>

            <div class="client-diagnostics-form">
                <label class="client-diagnostics-field">
                    <span>帳號</span>
                    <Input TValue="string" @bind-Value="diagnosticsAccount" Placeholder="要診斷的使用者帳號" MaxLength="100" />
                </label>
                <div class="client-diagnostics-field">
                    <span>等級</span>
                    <RadioGroup TValue="string" @bind-Value="diagnosticsLevel">
                        <Radio TValue="string" Value="@("DEBUG")">DEBUG</Radio>
                        <Radio TValue="string" Value="@("TRACE")">TRACE（含每次換頁與 API 呼叫）</Radio>
                    </RadioGroup>
                </div>
                <label class="client-diagnostics-field">
                    <span>時間</span>
                    <Select TItem="int" TItemValue="int" @bind-Value="diagnosticsMinutes" Style="width: 10rem;">
                        <SelectOptions>
                            @foreach (var minutes in DiagnosticsDurations)
                            {
                                <SelectOption TItem="int" TItemValue="int" Value="@minutes" Label="@DurationText(minutes)" />
                            }
                        </SelectOptions>
                    </Select>
                </label>
                <ToolbarIconButton Title="開始前端診斷記錄" Icon="play_arrow"
                                   Disabled="@string.IsNullOrWhiteSpace(diagnosticsAccount)"
                                   OnClick="@(async () => await OnStartDiagnosticsAsync())" />
            </div>

            @if (diagnosticsSessions.Count == 0)
            {
                <p class="client-diagnostics-empty">目前沒有開啟中的前端診斷記錄。</p>
            }
            else
            {
                <table class="client-diagnostics-table">
                    <thead>
                        <tr>
                            <th>帳號</th>
                            <th>等級</th>
                            <th>開始時間</th>
                            <th>到期時間</th>
                            <th>開啟者</th>
                            <th>操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var session in diagnosticsSessions)
                        {
                            <tr>
                                <td>@session.Account</td>
                                <td>@session.Level</td>
                                <td>@session.StartedAtLocal.ToString("yyyy/MM/dd HH:mm")</td>
                                <td>@session.ExpiresAtLocal.ToString("yyyy/MM/dd HH:mm")</td>
                                <td>@session.EnabledByAccount</td>
                                <td>
                                    <ToolbarIconButton Title="@($"停止 {session.Account} 的前端診斷記錄")" Icon="stop"
                                                       OnClick="@(async () => await OnStopDiagnosticsAsync(session))" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>
    </div>
}
