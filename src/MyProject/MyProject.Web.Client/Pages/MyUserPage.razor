@page "/myusers"
@attribute [Authorize]
@using MyProject.Web.Client.Views.Admins

@* 0.10.4 起在 WASM 執行（WASM 遷移 M5）。版面 ClientMainLayout 由 ClientRoutes 指定；[Authorize] 讓伺服器在整頁請求時先擋未登入者。 *@
<PageTitle>使用者管理</PageTitle>

<MyUserView InitialShowDeleted="@(Deleted == 1)" />

@code {
    /// <summary>「資料保留與清理」頁的「前往」帶 <c>?deleted=1</c>：一進來就顯示已刪除的資料（0.9.133 起）。</summary>
    [SupplyParameterFromQuery(Name = "deleted")]
    public int? Deleted { get; set; }
}
