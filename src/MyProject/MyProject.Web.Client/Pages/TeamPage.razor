@page "/teams"
@using MyProject.Web.Client.Views.Teams

@* 0.10.2 起在 WASM 執行（WASM 遷移 M3）。版面 ClientMainLayout 由 ClientRoutes 指定，登入檢查通過前不渲染（0.10.8 起不再由伺服器以 [Authorize] 擋整頁請求）。 *@
<PageTitle>團隊清單</PageTitle>

<TeamViewView InitialShowDeleted="@(Deleted == 1)" />

@code {
    /// <summary>「資料保留與清理」頁的「前往」帶 <c>?deleted=1</c>：一進來就顯示已刪除的資料（0.9.133 起）。</summary>
    [SupplyParameterFromQuery(Name = "deleted")]
    public int? Deleted { get; set; }
}
