<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!--
    WASM 前端（0.10.0 起，WASM 遷移 M1 建立空殼）。在使用者的瀏覽器執行：
    ⚠️ 只能參考 Dtos、Models、Share（ClientProjectBoundaryTests 守門），不可參考 Business、AccessDatas 或 Web。
    遷移期間由 MyProject.Web 一併提供（Blazor Web App 的 InteractiveWebAssembly 渲染模式），
    M11 起改為獨立的靜態站台。計畫見 docs/migration/WASM遷移計畫.md。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <!--
      載入完整的地區資料（0.10.2 起）：語系固定 zh-TW（見 ClientCulture），不跟著瀏覽器語言；
      預設只依瀏覽器語言載入一部分，英文瀏覽器會缺 zh-TW 的資料。下載量多約 1～2 MB，正式發佈的大小在 M12 量測。
    -->
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" />
    <PackageReference Include="AntDesign" />
    <PackageReference Include="BlazorMaterialIcons" />
    <!-- AI 回覆的 Markdown 在瀏覽器消毒成 HTML（0.10.5 起，AiMarkdownRenderer）。 -->
    <PackageReference Include="Markdig" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MyProject.Tests" />
  </ItemGroup>

  <!--
    登入、兩步驟驗證、忘記密碼、重設密碼四頁與共用外框 AuthShell 共用同一個 scoped CSS 識別碼（0.9.60 起；0.10.8 起搬到 WASM）。
    外觀規則全部寫在 Login.razor.css；其餘的 .razor.css 只是讓元件取得同一個 scope 屬性，
    這樣同一份規則就能套用到五個元件的標記上，不必複製 400 行樣式或改寫成 ::deep。
    ⚠️ 新增共用外框的頁面時要加進這裡，並附上自己的 .razor.css（可以只有註解）。
  -->
  <ItemGroup>
    <None Update="Views\Auths\Login.razor.css" CssScope="b-auth-shell" />
    <None Update="Views\Auths\AuthShell.razor.css" CssScope="b-auth-shell" />
    <None Update="Views\Auths\ForgotPassword.razor.css" CssScope="b-auth-shell" />
    <None Update="Views\Auths\ResetPassword.razor.css" CssScope="b-auth-shell" />
    <None Update="Views\Auths\TwoFactor.razor.css" CssScope="b-auth-shell" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyProject.Dtos\MyProject.Dtos.csproj" />
    <ProjectReference Include="..\MyProject.Models\MyProject.Models.csproj" />
    <ProjectReference Include="..\MyProject.Share\MyProject.Share.csproj" />
  </ItemGroup>

</Project>
