<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!--
    WASM 前端（0.10.0 起，WASM 遷移 M1 建立空殼）。在使用者的瀏覽器執行：
    ⚠️ 只能參考 Dtos、Models、Share（ClientProjectBoundaryTests 守門），不可參考 Business、AccessDatas 或 Web。
    0.10.10 起（WASM 遷移 M11）是獨立的 Blazor WebAssembly 靜態站台：入口頁 wwwroot/index.html，發佈輸出可以直接放上自己的 IIS 站台（web.config）；
    同站台部署時由 MyProject.Web 參考本專案、一併提供這些靜態檔。計畫見 docs/migration/WASM遷移計畫.md。
  -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <!--
      地區資料固定載入中日韓那一份（0.10.11 起，WASM 遷移 M12）：語系固定 zh-TW（見 ClientCulture），不跟著瀏覽器語言；
      預設只依瀏覽器語言挑一份，英文瀏覽器拿到的 icudt_EFIGS.dat 沒有 zh-TW。0.10.2～0.10.10 用 BlazorWebAssemblyLoadAllGlobalizationData 載入完整的 icudt.dat
      （Brotli 後 330 KB）；icudt_CJK.dat 含 zh、zh_Hant、zh_Hant_TW 與英文、根語系（Brotli 後 249 KB，少 81 KB）。
      ⚠️ 要用到中日韓以外的語系（例如格式化成法文）時改回 BlazorWebAssemblyLoadAllGlobalizationData。
    -->
    <BlazorIcuDataFileName>icudt_CJK.dat</BlazorIcuDataFileName>
    <!--
      index.html 的佔位（0.10.10 起，.NET 10 獨立 WebAssembly 的做法）：建置與發佈時填入 import map、preload 連結，
      並把 blazor.webassembly 的檔名換成帶指紋的版本。
    -->
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!--
      PWA（0.10.11 起，WASM 遷移 M12）：建置與發佈時產生 Service Worker 的資產清單 service-worker-assets.js（每個檔案的網址與 SHA-256、
      整份清單的版本）。Service Worker 只在安裝時把清單上的檔案放進快取，絕不快取 API 或資料（見 wwwroot/service-worker.published.js）。
    -->
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <!--
      WASM 發佈瘦身（0.10.14 起，升級 .NET 11）：.NET 11 為了支援 OpenTelemetry，把這三個執行期功能在 WebAssembly 的預設改成開啟
      （.NET 10 是關閉），修剪器因此留下計量、事件追蹤與 HTTP 追蹤傳遞的程式（System.Private.CoreLib、System.Diagnostics.DiagnosticSource 等變大）。
      前端沒有用 OpenTelemetry，明確關掉，讓 .NET 11「沒用到 OTEL 就修剪掉」的瘦身生效。⚠️ 之後要在前端接 OpenTelemetry 時改回 true。
    -->
    <MetricsSupport>false</MetricsSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <!--
      .NET 11 SDK 的 BL0014（for 迴圈變數被 lambda 捕捉）分析器在 Layout/ClientNavMenu.razor 的 BuildRenderTree 丟 NullReferenceException
      （AD0001，被 TreatWarningsAsErrors 升級成錯誤）；把那個檔的 @for 改成 foreach 就不會，但找不到確切的觸發寫法（0.10.14 實測）。
      目前四個 @for（ClientNavMenu、ClientSidebarMenuNode、ExceptionAiAnalysisModal、TokenUsageView）都沒有在 lambda 裡用到迴圈變數（人工確認）。
      ⚠️ 解除條件：SDK 修正這個分析器後拿掉這一行，確認建置不再出現 AD0001。
    -->
    <NoWarn>$(NoWarn);BL0014</NoWarn>
  </PropertyGroup>

  <!-- 不產生壓縮副本的檔案（appsettings.json、Service Worker 兩個檔案、manifest）：API 主機也匯入同一份，見檔案裡的說明。 -->
  <Import Project="FrontendCompression.props" />

  <!-- 開發時用 service-worker.js（不快取），發佈時換成 service-worker.published.js，SDK 在檔頭加上清單版本。 -->
  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" />
    <PackageReference Include="AntDesign" />
    <PackageReference Include="BlazorMaterialIcons" />
    <!-- AI 回覆的 Markdown 在瀏覽器消毒成 HTML（0.10.5 起，AiMarkdownRenderer）。 -->
    <PackageReference Include="Markdig" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MyProject.Tests" />
  </ItemGroup>

  <!--
    登入、兩步驟驗證、忘記密碼、重設密碼四頁與共用外框 AuthShell 共用同一個 scoped CSS 識別碼（0.9.60 起；0.10.8 起搬到 WASM）。
    外觀規則全部寫在 Login.razor.css；其餘的 .razor.css 只是讓元件取得同一個 scope 屬性，
    這樣同一份規則就能套用到五個元件的標記上，不必複製 400 行樣式或改寫成 ::deep。
    ⚠️ 新增共用外框的頁面時要加進這裡，並附上自己的 .razor.css（可以只有註解）。
  -->
  <ItemGroup>
    <None Update="Views\Auths\Login.razor.css" CssScope="b-auth-shell" />
    <None Update="Views\Auths\AuthShell.razor.css" CssScope="b-auth-shell" />
    <None Update="Views\Auths\ForgotPassword.razor.css" CssScope="b-auth-shell" />
    <None Update="Views\Auths\ResetPassword.razor.css" CssScope="b-auth-shell" />
    <None Update="Views\Auths\TwoFactor.razor.css" CssScope="b-auth-shell" />
  </ItemGroup>

  <!--
    靜態站台的 IIS 設定（0.10.10 起）：只在發佈本專案時放到輸出根目錄（取代 SDK 預設的 web.config）。
    刻意不當 Content：否則參考本專案的 MyProject.Web 發佈時也會帶上它，蓋掉 API 主機自己的 web.config。
  -->
  <ItemGroup>
    <Content Remove="web.config" />
    <None Include="web.config" />
  </ItemGroup>

  <Target Name="AddStaticSiteWebConfigToPublish" BeforeTargets="_AddWasmWebConfigFile">
    <ItemGroup>
      <ResolvedFileToPublish Include="$(MSBuildProjectDirectory)\web.config" RelativePath="web.config" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    </ItemGroup>
  </Target>

  <!--
    把 index.html 裡 import map 的 SHA-256 填進發佈出去的 web.config（CSP 的 script-src）。import map 的內容是發佈時才產生的
    （檔名指紋），每次都不同，所以不能寫死。雜湊的算法與 API 主機的 FrontendContentSecurityPolicy.ImportMapHash 相同：先把換行正規化成 LF。
    ⚠️ 一律從專案裡的 web.config 範本讀、寫到發佈輸出（0.10.10 獨立審查：讀輸出裡的那份時，同一個資料夾第二次發佈會因佔位已被換掉而失敗）。

    雙站台（0.10.10 起）：發佈時帶 -p:StaticSiteApiOrigin=https://api.公司.com（只要 scheme＋主機＋連接埠），
    同時填入 wwwroot/appsettings.json 的 ApiBaseUrl 與 CSP 的 connect-src —— 兩處一致，重新發佈也不會被蓋回空白。
    PWA（0.10.11 起）：appsettings.json 的內容變了，Service Worker 資產清單（service-worker-assets.js）上它的雜湊與清單版本、
    service-worker.js 的版本註解一起更新（否則 Service Worker 以 integrity 驗證失敗、整個安裝失敗）。
  -->
  <UsingTask TaskName="FillImportMapHash" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <IndexHtml ParameterType="System.String" Required="true" />
      <Template ParameterType="System.String" Required="true" />
      <WebConfig ParameterType="System.String" Required="true" />
      <ApiOrigin ParameterType="System.String" />
      <AppSettingsTemplate ParameterType="System.String" Required="true" />
      <AppSettings ParameterType="System.String" Required="true" />
      <ServiceWorkerAssets ParameterType="System.String" Required="true" />
      <ServiceWorkerScript ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Security.Cryptography" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var html = File.ReadAllText(IndexHtml);
        var match = Regex.Match(html, @"<script type=""importmap"">(?<content>[\s\S]*?)</script>");
        if (!match.Success)
        {
          Log.LogError("發佈的 index.html 裡找不到 import map，無法填入 web.config 的 CSP 雜湊：" + IndexHtml);
          return false;
        }

        var content = match.Groups["content"].Value.Replace("\r\n", "\n").Replace('\r', '\n');
        string hash;
        using (var sha = SHA256.Create())
        {
          hash = Convert.ToBase64String(sha.ComputeHash(Encoding.UTF8.GetBytes(content)));
        }

        var config = File.ReadAllText(Template);
        if (!config.Contains("__IMPORTMAP_SHA256__"))
        {
          Log.LogError("web.config 範本的 CSP 裡找不到 __IMPORTMAP_SHA256__ 佔位：" + Template);
          return false;
        }

        config = config.Replace("__IMPORTMAP_SHA256__", hash);
        // appsettings.json 也一律從專案裡的範本重寫：上一次發佈填過 API 網址、這次沒帶時不能沿用舊值。
        var settings = File.ReadAllText(AppSettingsTemplate);
        if (!string.IsNullOrWhiteSpace(ApiOrigin))
        {
          Uri origin;
          if (!Uri.TryCreate(ApiOrigin.Trim(), UriKind.Absolute, out origin)
              || (origin.Scheme != "https" && origin.Scheme != "http")
              || origin.AbsolutePath != "/" || origin.Query.Length > 0 || origin.Fragment.Length > 0)
          {
            Log.LogError("StaticSiteApiOrigin 必須是只有 scheme＋主機＋連接埠的 http(s) 網址（例如 https://api.example.com），目前是：" + ApiOrigin);
            return false;
          }

          var originText = origin.GetLeftPart(UriPartial.Authority);
          var csp = Regex.Match(config, @"(<add name=""Content-Security-Policy"" value=""[^""]*connect-src 'self')");
          if (!csp.Success)
          {
            Log.LogError("web.config 範本的 Content-Security-Policy 裡找不到 connect-src 'self'：" + Template);
            return false;
          }

          config = config.Substring(0, csp.Index + csp.Length) + " " + originText + config.Substring(csp.Index + csp.Length);
          var pattern = new Regex(@"""ApiBaseUrl""\s*:\s*""[^""]*""");
          if (!pattern.IsMatch(settings))
          {
            Log.LogError("wwwroot/appsettings.json 範本裡找不到 ApiBaseUrl：" + AppSettingsTemplate);
            return false;
          }

          settings = pattern.Replace(settings, "\"ApiBaseUrl\": \"" + originText + "/\"");
          Log.LogMessage(MessageImportance.High, "雙站台：ApiBaseUrl 與 CSP 的 connect-src 已填入 " + originText);
        }

        File.WriteAllText(AppSettings, settings, new UTF8Encoding(false));

        // Service Worker 的資產清單（0.10.11 起）：appsettings.json 改寫後，清單上的雜湊要跟著改（Service Worker 安裝時以 integrity 驗證，
        // 對不上整個安裝失敗、離線就開不起來）；內容變了也要換清單版本（快取名稱與 service-worker.js 的版本註解跟著變，瀏覽器才知道有新版）。
        if (File.Exists(ServiceWorkerAssets))
        {
          string settingsHash;
          using (var sha = SHA256.Create())
          {
            settingsHash = "sha256-" + Convert.ToBase64String(sha.ComputeHash(File.ReadAllBytes(AppSettings)));
          }

          var assets = File.ReadAllText(ServiceWorkerAssets);
          var entry = Regex.Match(assets, @"""hash"":\s*""(?<hash>[^""]+)"",\s*""url"":\s*""appsettings\.json""");
          var version = Regex.Match(assets, @"""version"":\s*""(?<version>[^""]+)""");
          if (!entry.Success || !version.Success)
          {
            Log.LogError("Service Worker 的資產清單裡找不到 appsettings.json 或版本：" + ServiceWorkerAssets);
            return false;
          }

          if (entry.Groups["hash"].Value != settingsHash)
          {
            var oldVersion = version.Groups["version"].Value;
            string newVersion;
            using (var sha = SHA256.Create())
            {
              newVersion = Convert.ToBase64String(sha.ComputeHash(Encoding.UTF8.GetBytes(oldVersion + settingsHash))).Substring(0, 8);
            }

            var oldHash = entry.Groups["hash"];
            assets = assets.Substring(0, oldHash.Index) + settingsHash + assets.Substring(oldHash.Index + oldHash.Length);
            var versionValue = Regex.Match(assets, @"""version"":\s*""(?<version>[^""]+)""").Groups["version"];
            assets = assets.Substring(0, versionValue.Index) + newVersion + assets.Substring(versionValue.Index + versionValue.Length);

            var worker = File.ReadAllText(ServiceWorkerScript);
            var marker = "/* Manifest version: " + oldVersion + " */";
            if (!worker.Contains(marker))
            {
              Log.LogError("service-worker.js 裡找不到清單版本的註解（" + marker + "）：" + ServiceWorkerScript);
              return false;
            }

            File.WriteAllText(ServiceWorkerAssets, assets, new UTF8Encoding(false));
            File.WriteAllText(ServiceWorkerScript, worker.Replace(marker, "/* Manifest version: " + newVersion + " */"), new UTF8Encoding(false));
            Log.LogMessage(MessageImportance.High, "Service Worker 的資產清單已更新 appsettings.json 的雜湊，版本 " + oldVersion + " → " + newVersion);
          }
        }

        File.WriteAllText(WebConfig, config, new UTF8Encoding(false));
        Log.LogMessage(MessageImportance.High, "web.config 的 CSP 已填入 import map 的雜湊 sha256-" + hash);
]]></Code>
    </Task>
  </UsingTask>

  <Target Name="FillStaticSiteImportMapHash" AfterTargets="Publish">
    <FillImportMapHash IndexHtml="$(PublishDir)wwwroot\index.html" Template="$(MSBuildProjectDirectory)\web.config" WebConfig="$(PublishDir)web.config"
                       ApiOrigin="$(StaticSiteApiOrigin)" AppSettingsTemplate="$(MSBuildProjectDirectory)\wwwroot\appsettings.json" AppSettings="$(PublishDir)wwwroot\appsettings.json"
                       ServiceWorkerAssets="$(PublishDir)wwwroot\$(ServiceWorkerAssetsManifest)" ServiceWorkerScript="$(PublishDir)wwwroot\service-worker.js" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\MyProject.Dtos\MyProject.Dtos.csproj" />
    <ProjectReference Include="..\MyProject.Models\MyProject.Models.csproj" />
    <ProjectReference Include="..\MyProject.Share\MyProject.Share.csproj" />
  </ItemGroup>

</Project>
