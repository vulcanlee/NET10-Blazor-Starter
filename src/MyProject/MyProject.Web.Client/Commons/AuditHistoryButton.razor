@namespace MyProject.Web.Components.Commons
@* 0.10.2 起放在 MyProject.Web.Client（WASM 遷移 M3）；命名空間維持不變。 *@
@using MyProject.Web.Client.Auth

@*
    資料頁每一列的「異動歷程」按鈕（0.9.173 起）。只有管理員看得到：稽核紀錄含來源 IP 與別人的操作，
    與「稽核紀錄」頁同樣只給管理員（權限鍵不上架角色矩陣）。非管理員什麼都不渲染，連 SpaceItem 都不留。
    按下後由頁面呼叫自己那一個 AuditHistoryDialog.ShowAsync —— 一頁只放一個對話窗，不是每列一個。
*@
@if (Permissions.IsAdmin)
{
    <SpaceItem>
        <CrudActionButton Title="異動歷程" Icon="history" OnClick="OnClick" />
    </SpaceItem>
}

@code {
    [Inject]
    public PagePermissions Permissions { get; set; } = default!;

    [Parameter]
    public EventCallback OnClick { get; set; }
}
