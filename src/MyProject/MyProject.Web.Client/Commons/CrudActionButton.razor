@namespace MyProject.Web.Components.Commons
@* 0.10.2 起放在 MyProject.Web.Client（WASM 遷移 M3）；命名空間維持不變。 *@
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web

<Tooltip Title="@Title" @bind-Visible="tooltipVisible">
    @if (!string.IsNullOrWhiteSpace(Href))
    {
        <a class="@CssClass"
           href="@Href"
           target="@Target"
           title="@Title"
           aria-label="@Title">
            <MaterialIcon Theme="@MaterialIcon.Themes.Outlined" Kind="@Icon" />
        </a>
    }
    else
    {
        <Button Type="ButtonType.Default"
                Class="@CssClass"
                Disabled="@Disabled"
                OnClick="HandleClickAsync">
            <MaterialIcon Theme="@MaterialIcon.Themes.Outlined" Kind="@Icon" />
            <span class="crud-action-button-label">@Title</span>
        </Button>
    }
</Tooltip>

@code {
    [Parameter]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string Icon { get; set; } = string.Empty;

    [Parameter]
    public EventCallback OnClick { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string? Href { get; set; }

    [Parameter]
    public string Target { get; set; } = "_blank";

    [Parameter]
    public bool Danger { get; set; }

    private string CssClass => Danger
        ? "crud-action-button crud-action-button-danger"
        : "crud-action-button";

    /// <summary>
    /// 提示框是否顯示：按下時收起（0.10.11 最終巡檢發現）—— 按鈕在處理期間重新渲染時，滑鼠離開的事件可能不會觸發，
    /// 提示框就一直停著（例如 AI 對話窗的「產生 PDF 報告並下載」蓋住右上角的關閉鈕）。
    /// </summary>
    private bool tooltipVisible;

    private async Task HandleClickAsync(MouseEventArgs args)
    {
        tooltipVisible = false;
        await OnClick.InvokeAsync();
        // 處理期間滑鼠還停在按鈕上，提示框可能又被打開，之後滑鼠離開的事件卻沒有觸發（例如「匯出 Excel」下載完）：
        // 處理完再收起一次（0.10.16 起，.NET 11 全面實機探索發現）。
        tooltipVisible = false;
    }
}
