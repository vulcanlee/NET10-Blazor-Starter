@inherits LayoutComponentBase

@*
    WASM 頁面的版面（0.10.1 起，WASM 遷移 M2）：資料來自 Web API。0.10.9 起 Server 版 MainLayout 已刪除，這裡是唯一的一份。

    ⚠️ 這裡就是登入的閘門（0.10.8 起純 Token 登入，伺服器不再以 [Authorize] 擋整頁請求）：
    登入檢查（ClientSession.InitializeAsync：Token、/me）完成前整個版面（側邊欄、頁首、頁面本體、對話窗）都不渲染（0.10.13 起改顯示載入卡片）；
    沒有 Token 或 Token 失效就帶 returnUrl 回登入頁，帳號停用／被刪／沒有主要角色也一樣不渲染。由 PageAuthorizationTests 守門。
*@
@if (isAuthenticated)
{
    <div class="page @(isSidebarCollapsed ? "sidebar-collapsed" : string.Empty)">
        <div class="sidebar">
            <ClientNavMenu IsSidebarCollapsed="isSidebarCollapsed" OnSidebarToggle="ToggleSidebar" MenuItems="MenuItems" SystemName="@SystemName" />
        </div>

        <main>
            <div class="top-row px-4">
                <div class="top-row-heading">
                    <div class="top-row-title">@CurrentPageTitle</div>
                    <ClientPageHelpDialog Topics="HelpTopics" />
                </div>
                <div class="top-row-status">
                    <ClientNotificationBell />
                    <div class="user-menu @(isUserMenuOpen ? "user-menu-open" : string.Empty)">
                        <button type="button"
                                class="user-menu-trigger"
                                aria-label="使用者操作"
                                aria-expanded="@isUserMenuOpen"
                                aria-haspopup="menu"
                                @onclick="ToggleUserMenu">
                            @* 0.9.102 起以姓名縮寫取代人像圖示（不做頭像上傳）。 *@
                            <span class="user-menu-icon user-menu-initials" aria-hidden="true">@CurrentUserInitials</span>
                            <span class="user-menu-text">
                                <span class="user-menu-name">@CurrentUserDisplayName</span>
                                @if (CurrentUserIsAdmin)
                                {
                                    <span class="user-menu-badge">管理員</span>
                                }
                            </span>
                            <span class="user-menu-caret" aria-hidden="true">
                                <MaterialIcon Theme="@MaterialIcon.Themes.Outlined" Kind="expand_more" />
                            </span>
                        </button>

                        <div class="user-menu-dropdown @(isUserMenuOpen ? "user-menu-dropdown-open" : string.Empty)"
                             role="menu"
                             aria-label="使用者操作">
                            <button type="button" class="user-menu-item" role="menuitem" @onclick="OnProfileClick">個人資料</button>
                            <button type="button" class="user-menu-item" role="menuitem" @onclick="OnChangePasswordClick">變更密碼</button>
                            <button type="button" class="user-menu-item" role="menuitem" @onclick="OnAboutClick">關於</button>
                            <button type="button" class="user-menu-item" role="menuitem" @onclick="OnLogoutClickAsync">登出</button>
                        </div>
                    </div>
                </div>
            </div>

            <ClientAnnouncementBanner />

            <article class="content px-4">
                @Body
            </article>
        </main>
    </div>

    @* 尺寸寫在 MyProject.Web.Client/Commons/OverlayStyles.razor 的 .about-modal，不用 Width 參數（速查表 §6.4）。 *@
    <Modal Title="關於"
           Class="about-modal"
           @bind-Visible="@aboutVisible"
           Keyboard="true"
           Footer="null"
           OnCancel="OnAboutCancel">
        <dl class="about-list">
            @foreach (var item in aboutItems)
            {
                <div class="about-row">
                    <dt class="about-term">@item.Key</dt>
                    <dd class="about-value">@item.Value</dd>
                </div>
            }
        </dl>
    </Modal>
}
else if (Session.IsThrottled)
{
    @* 伺服器暫時限流（429，0.10.5 起）：不把人丟回登入頁，請他稍等再重新整理。 *@
    <div class="session-throttled" role="alert">
        <p>@ClientSession.ThrottledMessage</p>
        <button type="button" class="btn btn-primary" @onclick="ReloadPage">重新整理</button>
    </div>
}
else if (Session.IsUnreachable)
{
    @* 連不上伺服器（0.10.11 起：離線時 Service Worker 照樣開得起外框）：保留登入，恢復連線時自動重新載入（ClientConnectivity）。 *@
    <div class="session-throttled" role="alert">
        <p>@ClientSession.UnreachableMessage</p>
        <button type="button" class="btn btn-primary" @onclick="ReloadPage">重新整理</button>
    </div>
}
else
{
    @*
        登入檢查（Token、/me）與讀取外框資料期間（0.10.13 起）：接續 index.html 下載期間的載入卡片，不再整片空白。
        卡片只有固定的系統名稱與說明文字，不含任何需要登入才能看的內容；檢查失敗時 ClientSession 會帶到登入頁。
    *@
    <ClientLoadingScreen Message="正在確認登入狀態…" />
}

<div id="blazor-error-ui" data-nosnippet>
    系統發生未預期的錯誤。
    <a href="." class="reload">重新整理</a>
    <span class="dismiss">關閉</span>
</div>
