@using Microsoft.Extensions.Logging
@implements IDisposable
@inject IJSRuntime JSRuntime
@inject ILogger<ClientUpdateBar> Logger

@*
    新版本提示列（0.10.11 起，WASM 遷移 M12）：掛在根元件 ClientRoutes。部署新版後，新的 Service Worker 裝好、停在等待時由 js/pwa.js 通知；
    使用者按下才套用（送 SKIP_WAITING、換好後整頁重新載入一次），不強制重新載入 —— 使用者可能正在編輯。
    開發模式（不快取的 service-worker.js）不會出現。樣式在 ClientUpdateBar.razor.css。
*@
@if (isUpdateAvailable)
{
    <div class="app-update-bar" role="status">
        <button type="button" class="app-update-apply" @onclick="ApplyAsync">有新版本，按這裡重新整理</button>
        <button type="button" class="app-update-later" @onclick="Later">稍後</button>
    </div>
}

@code {
    private DotNetObjectReference<ClientUpdateBar>? self;
    private bool isUpdateAvailable;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        self = DotNetObjectReference.Create(this);
        try
        {
            await JSRuntime.InvokeVoidAsync("appPwa.watchUpdates", self);
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "Failed to watch for new versions.");
        }
    }

    /// <summary>由 js/pwa.js 在新版的 Service Worker 等待中時呼叫。</summary>
    [JSInvokable]
    public async Task OnUpdateAvailable()
    {
        isUpdateAvailable = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task ApplyAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("appPwa.applyUpdate");
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "Failed to apply the new version.");
        }
    }

    /// <summary>「稍後」：先收起來，下次開頁（或重新整理）時還會再出現。</summary>
    private void Later() => isUpdateAvailable = false;

    public void Dispose() => self?.Dispose();
}
