@inherits LayoutComponentBase

@* 沒有外框的 WASM 版面（0.10.8 起，WASM 遷移 M9）：啟動頁、系統錯誤頁。標記與樣式照抄 Server 版 EmptyLayout。 *@
<div class="page">
    <main>
        <div style="margin-bottom: 60px">
            @Body
        </div>
    </main>
</div>

<div id="blazor-error-ui">
    系統發生未預期的錯誤。
    <a href="" class="reload">重新整理</a>
    <a class="dismiss">🗙</a>
</div>
