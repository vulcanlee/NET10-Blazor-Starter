<Project>

  <!--
    Central Package Management：所有套件版本的單一來源。
    個別 csproj 只寫 <PackageReference Include="..." />，不再帶 Version。
    升級套件請一律改這裡，避免同一套件在不同專案版本不一致。
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- ASP.NET Core / EF Core（隨 .NET 版本一起升級） -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.Google"      Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer"   Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Authorization"   Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly"     Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing"                Version="11.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design"            Version="11.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite"            Version="11.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools"             Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="11.0.0" />
  </ItemGroup>

  <!-- UI 與工具 -->
  <ItemGroup>
    <PackageVersion Include="AntDesign"              Version="1.6.3-dotnet11.rc3" />
    <PackageVersion Include="AutoMapper"             Version="16.3.0" />
    <PackageVersion Include="BlazorMaterialIcons"    Version="0.0.1" />
    <PackageVersion Include="Cronos"                 Version="0.13.0" />
    <PackageVersion Include="MailKit"                Version="4.18.2" />
    <PackageVersion Include="Markdig"                Version="1.6.0" />
    <PackageVersion Include="NLog.Web.AspNetCore"    Version="6.3.0" />
    <PackageVersion Include="Newtonsoft.Json"        Version="13.0.4" />
    <!-- 0.9.164：PDFsharp-MigraDoc 刻意停在 6.2.4（MIT）。6.5.0 起授權改為 AGPL-3.0 或商業授權，
         且程式必須呼叫 PdfSharpLicense.SetAgplLicense()／LoadLicense() 選擇授權，否則丟 PdfSharpLicenseException。
         升級前要先決定授權方式（AGPL 會要求公開衍生產品原始碼）。 -->
    <PackageVersion Include="PDFsharp-MigraDoc"      Version="6.2.4" />
    <PackageVersion Include="QRCoder"                Version="1.8.1" />
    <!-- 0.9.107 起：業務頁匯出 Excel。傳遞相依 SixLabors.Fonts 解析到 1.0.0（Apache-2.0；2.x 起改為 Split License，升級前要確認）。 -->
    <PackageVersion Include="ClosedXML"              Version="0.105.1" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="11.0.1" />
  </ItemGroup>

  <!--
    AI 呼叫（0.9.140 起）：所有 LLM 呼叫一律經 Microsoft Agent Framework（MAF）。
    Azure OpenAI 也走 OpenAI 官方 SDK 指向 v1 端點，刻意不用 Azure.AI.OpenAI（新版仍是預覽）。
    設計見 docs/architecture/MAF-AI呼叫架構.md。
    0.9.144 起：多 Agent 工作流程用 Microsoft.Agents.AI.Workflows（版本與 Microsoft.Agents.AI 對齊）。
  -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Agents.AI"            Version="1.28.0" />
    <PackageVersion Include="Microsoft.Agents.AI.OpenAI"     Version="1.28.0" />
    <PackageVersion Include="Microsoft.Agents.AI.Workflows"  Version="1.28.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.11.0" />
    <!-- 0.9.164：OpenAI 刻意停在 2.14.0。2.15.0 改了 ResponsesClient.CreateResponseStreamingAsync 的簽章，
         Microsoft.Extensions.AI.OpenAI 10.11.0（MAF 1.28 也相依 2.14.0）執行時會丟 MissingMethodException。
         升級條件：Microsoft.Extensions.AI.OpenAI 釋出相依 >= 2.15 的版本後再一起升。 -->
    <PackageVersion Include="OpenAI"                         Version="2.14.0" />
  </ItemGroup>

  <!-- 測試 -->
  <ItemGroup>
    <PackageVersion Include="bunit"                     Version="2.15.2" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk"    Version="18.12.0" />
    <PackageVersion Include="coverlet.collector"        Version="10.1.0" />
    <PackageVersion Include="xunit"                     Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

</Project>
